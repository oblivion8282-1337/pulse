# MediaMTX-Config für Pulse — TEMPLATE  (MediaMTX 1.18.1)
#
# Auth: per-Channel-HQ-Streaming via `authMethod: http` (T5a).
#   MediaMTX delegiert *jede* Connection an den Pulse `mediamtx-auth-hook`
#   (FastAPI, Dev: http://localhost:8005/ — siehe services/mediamtx-auth-hook/).
#   Der Hook erlaubt:
#     - publish nur mit gültigem Stream-Token (von media-svc ausgegeben) für den
#       Pfad `channel-<channel_id>`,
#     - read/playback (WHEP/HLS) anonym für `channel-*`-Pfade
#       (T5a; T5b ergänzt einen Pulse-Member-Token-Check für Reads),
#     - api/metrics/pprof (wird hier zusätzlich via authHTTPExclude ausgeschlossen).
#   → Es gibt keine internen User mehr, keinen festen Stream-Key. Der GSR-Sidecar
#     bekommt seine Push-URL (inkl. Token als `?pass=…` bzw.
#     `streamid=publish:<path>:pulse:<token>`) von media-svc
#     (`POST /channels/{id}/stream-token`).
#
# Vor Deploy (T5c): nur `authHTTPAddress` auf den erreichbaren Hook-Endpunkt
#   zeigen lassen (Dev: localhost:8005 — MediaMTX läuft mit network_mode: host,
#   localhost:8005 vom Container = Host-localhost = wo der auth-hook via uvicorn
#   lauscht). Sonst ist hier nichts mehr zu ersetzen.

logLevel: info
logDestinations: [stdout]

# RTMP-Ingest — RTMPS-only auf :1936. Plain RTMP :1935 ist aus, weil media-svc
# nur rtmps://-URLs ausgibt (sonst wäre der Publish-Token im Klartext).
# Braucht ein self-signed Cert-Pair unter streaming/server/certs/server.{crt,key}
# (in den Container nach /certs/ gemounted). Wenn du das noch nicht hast:
#   cd streaming/server && mkdir -p certs && \
#     openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
#       -keyout certs/server.key -out certs/server.crt \
#       -subj "/CN=localhost"
rtmp: yes
rtmpEncryption: strict
rtmpsAddress: :1936
rtmpServerCert: /certs/server.crt
rtmpServerKey: /certs/server.key

# HLS Low-Latency
# HLS AUS (2026-08-03). Es wird auf diesem Weg von niemandem gelesen — der
# Zuschauer kommt ueber WHEP —, und mit `PULSE_KEYFRAME_INTERVAL=0`
# (Intra-Refresh) ist es aktiv schaedlich: HLS kann ein Segment nur an einem
# Keyframe abschliessen. Ohne regelmaessige Keyframes waechst es bis zur
# Grenze, der Muxer stuerzt ab ("reached maximum segment size") und faengt von
# vorn an — gemessen alle rund 66 Sekunden, dauerhaft, mit Lastspitze bei
# jedem Neustart.
#
# `hlsAlwaysRemux: yes` machte es schlimmer: damit baut MediaMTX die Segmente
# auch dann, wenn niemand zusieht. Wer HLS zurueckholt, sollte zumindest das
# ausschalten — und wissen, dass es mit Intra-Refresh nicht zusammengeht.
# Dieselbe Falle wartet auf der Produktion: dort ist HLS an.
hls: no
hlsAddress: :8888
hlsAlwaysRemux: yes
hlsVariant: lowLatency
hlsSegmentCount: 7
hlsSegmentDuration: 200ms
hlsPartDuration: 100ms

# WebRTC / WHEP (kein Audio auf dem RTMP/FLV-Pfad wegen AAC-Limit; SRT trägt Opus)
webrtc: yes
webrtcAddress: :8889
webrtcLocalUDPAddress: :8189
# Wie prod (infra/prod/mediamtx.yml): `yes` würde bei network_mode:host JEDE
# Host-Schnittstelle als ICE-Kandidat anbieten — Docker-Bridges (172.x) und die
# link-local `fe80::…`. Der Viewer verplempert dann seine ersten ICE-Runden auf
# unerreichbaren Kandidaten (`deadline exceeded`), bevor der erreichbare dran
# ist. Lokal ist der Viewer immer derselbe Host → 127.0.0.1 genügt und ist
# eindeutig.
# Von einem ANDEREN Gerät im LAN testen? Dann hier die LAN-IP dieses Rechners
# ergänzen — sonst kennt der Viewer keinen erreichbaren Kandidaten.
webrtcIPsFromInterfaces: no
webrtcAdditionalHosts:
  - 127.0.0.1

# API NUR auf localhost (media-svc pollt /v3/paths/list darüber)
api: yes
apiAddress: 127.0.0.1:9997

# Disable RTSP — RTMP + SRT reichen
rtsp: no

# SRT-Ingest für Opus-Audio-Pfad (RTMP/FLV kann nur AAC)
# Push-streamid: publish:<path>:pulse:<stream-token>
srt: yes
srtAddress: :8890

# === AUTH ===
# HTTP-delegierte Authentifizierung an den Pulse mediamtx-auth-hook.
authMethod: http
authHTTPAddress: http://localhost:8005/
authHTTPExclude:
  - action: api
  - action: metrics
  - action: pprof

paths:
  # Pulse HQ-Channel-Streams heißen `channel-<snowflake>`. Erlaubt/abgelehnt
  # wird jede Connection vom auth-hook — hier reicht der Default-Eintrag, damit
  # MediaMTX die (dynamischen) Pfade überhaupt akzeptiert. Nicht-`channel-*`-
  # Pfade lehnt der Hook ab.
  all_others:
