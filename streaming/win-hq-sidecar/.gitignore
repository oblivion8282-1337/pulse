/target
/Cargo.lock
# Gepatchter windows-capture-Zweig: `scripts/bootstrap-windows-capture.sh`
# stellt ihn reproduzierbar her (crates.io-Tarball + patches/), wie
# `pulse-player/vendor/webrtc-rs`.
/vendor/
# Smoke-test artefacts (a 4K BMP is ~24 MB and uncompressed; don't commit).
capture_smoke_*.bmp
capture_smoke_*.png
audio_smoke_*.wav
encode_smoke*.mp4
encode_smoke*.flv
# FFmpeg-LGPL-Distribution: per `scripts/fetch-ffmpeg.ps1` heruntergeladen (Pin
# = URL + SHA256 im Script) oder per `scripts/build-ffmpeg-patched.ps1` selbst
# gebaut. Enthält dann auch dessen Quellbaum unter `_build/` (mehrere GB) —
# `build-ffmpeg-patched.ps1 -Clean` räumt ihn weg.
/ffmpeg-dist/
# MediaMTX-Standalone-Binary für lokale Test-Driver-Runs (`scripts/fetch-mediamtx.ps1`).
/mediamtx-dist/
# Test-Driver-Logs.
/target/test-driver-*.log
