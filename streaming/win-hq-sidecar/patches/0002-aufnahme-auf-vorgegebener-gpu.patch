+    /// Pulse patch: a caller-supplied Direct3D 11 device to capture onto.
+    ///
+    /// Without this, `capture.rs` builds its own device via
+    /// `D3D11CreateDevice(None, D3D_DRIVER_TYPE_HARDWARE, ...)`, which lets
+    /// Windows pick the adapter — on machines with both integrated and discrete
+    /// graphics that is usually the integrated one, because it drives the
+    /// display. Everything downstream of the capture (encoder vendor, encode
+    /// path) follows from that adapter, so the choice has to be made here or
+    /// not at all. `None` keeps the crate's original behaviour.
+    pub(crate) d3d_device: Option<(
