+    /// Pulse patch: capture onto a caller-supplied Direct3D 11 device instead
+    /// of one created by this crate. See the `d3d_device` field for why.
+    ///
+    /// Added as a builder method rather than a `new` parameter so that existing
+    /// call sites keep compiling unchanged.
+    #[inline]
+    #[must_use]
+    pub fn with_d3d_device(
+        mut self,
+        device: ::windows::Win32::Graphics::Direct3D11::ID3D11Device,
+        context: ::windows::Win32::Graphics::Direct3D11::ID3D11DeviceContext,
+    ) -> Self {
+        self.d3d_device = Some((device, context));
+        self
+    }
