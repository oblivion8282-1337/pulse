+
+// pulseFecTor entscheidet, ob die Paritaetspakete tatsaechlich hinausgehen.
+//
+// WARUM ES DAS GIBT: Der Aufschlag ist sonst fest rund 20 Prozent — unabhaengig
+// davon, ob ueberhaupt etwas verloren geht, und MediaMTX faechert ihn an JEDEN
+// Zuschauer auf. Auf einer gesunden Leitung ist er damit vollstaendig umsonst
+// bezahlt.
+//
+// WIE ES GEREGELT WIRD — und warum NICHT ueber `fraction lost`:
+//
+// Die erste Fassung (2026-07-31) nahm `fraction lost` aus den Receiver Reports
+// als Regelgroesse und liess die Paritaet oberhalb einer Schwelle laufen. Sie
+// ist gemessen gescheitert (`fec-2026-07-31-schwelle-taugt-nicht.json`): 152
+// Paritaetspakete reparierten NULL Pakete. Drei Gruende, alle drei bleiben
+// bestehen, egal wie man die Schwelle stellt:
+//
+//  1. `fraction lost` wird NACH der NACK-Reparatur gebildet. Was der Empfaenger
+//     nachfordern konnte, taucht darin gar nicht auf — der Ausloeser ist also
+//     nicht nur spaet, sondern auch zu schwach.
+//  2. Er ist ein 8-Bit-Wert (Anteil mal 256, RFC 3550 §6.4.1). Die feinste
+//     ueberhaupt einstellbare Stufe ist 1/256 = 0,39 Prozent; dazwischen gibt
+//     es nichts.
+//  3. Er kommt einmal je Report-Zyklus, also rund einmal pro Sekunde.
+//
+// Diese Fassung nimmt stattdessen den EINGEHENDEN NACK. Der ist in allen drei
+// Punkten das Gegenteil: er meldet den ROHEN Verlust, bevor irgendetwas
+// repariert wurde, er nennt die verlorenen Sequenznummern einzeln (keine
+// Quantisierung), und er kommt sofort — eine halbe Umlaufzeit nach dem Verlust
+// statt am Ende eines Report-Zyklus.
+//
+// DIE ZWEITE HAELFTE DES PROBLEMS ist damit noch nicht geloest: Paritaet
+// schuetzt die Pakete, die NACH ihr kommen. Jede Regelung, die auf gemessenen
+// Verlust reagiert, ist also grundsaetzlich zu spaet fuer den Verlust, der sie
+// ausgeloest hat. Dagegen zwei Mittel, beide bewusst unsymmetrisch:
+//
+//   - HALTEZEIT statt kurzem Fenster. Das Tor geht sofort auf und bleibt danach
+//     `haltezeit` lang offen (Vorgabe 10 s). Verlust tritt in Phasen auf; wer
+//     einmal verloren hat, verliert gleich wieder. Die erste Fassung schloss
+//     nach zwei Sekunden wieder und war damit, wie die Messakte es nennt,
+//     „immer im falschen Moment offen".
+//   - ANLAUFFENSTER. Die ersten `anlauf` Sekunden einer Sitzung laeuft die
+//     Paritaet immer (Vorgabe 5 s). Das ist der Moment, in dem das
+//     Einstiegs-Vollbild kommt — 25 bis 35 Pakete am Stueck, deren Verlust den
+//     Zuschauer ohne Bild sitzen laesst, und bei Intra-Refresh gibt es keinen
+//     zweiten Einstiegspunkt.
+//
+// WO DER FILTER SITZEN MUSS: direkt NACH dem Erzeuger und VOR TWCC. Verwuerfe
+// er nach der TWCC-Markierung, erschienen die verworfenen Pakete beim
+// Zuschauer als Verlust — eine Regelschleife, die sich von ihrer eigenen
+// Wirkung fuettert.
+// AUF EINEN NACK ALLEIN DARF DAS TOR NICHT HOEREN. Gemessen am 2026-08-04 auf
+// der Laborstrecke: in einem Lauf mit 15 s Stoerung und 30 s Ruhe im Wechsel
+// kamen in 108 von 119 Sekunden NACKs an, auch in den ruhigen Abschnitten (1
+// bis 4 je Sekunde). Ein Tor, das bei jedem NACK aufgeht und zehn Sekunden
+// haelt, schliesst damit NIE — gemessen: null unterdrueckte Paritaetspakete,
+// voller Aufschlag. Entschieden wird deshalb an der RATE, nicht an der
+// Anwesenheit.
+//
+// UND DER ROHZAEHLER TAUGT DAFUER NICHT. Derselbe Lauf: 7442 gemeldete
+// Verluste in 120 s gegen 449 Medienpakete je Sekunde — das waeren 14 Prozent
+// Verlust bei 2 Prozent eingestellter Stoerung. Chromium fordert dieselbe
+// Luecke mehrfach an (im Labor 6- bis 8-mal, deshalb gibt es die
+// NACK-Sperrfrist im Player). Gezaehlt werden hier deshalb VERSCHIEDENE
+// Sequenznummern je Fenster; sonst regelt das Tor auf die Hartnaeckigkeit des
+// Empfaengers statt auf den Verlust der Leitung.
+type pulseFecTor struct {
+	// UnixNano des letzten Fensters ueber der Schwelle; 0 heisst "noch keins".
+	letzterVerlust atomic.Int64
+	beginn         time.Time
+	haltezeit      time.Duration
+	anlauf         time.Duration
+
+	// Messfenster fuer die Verlustrate.
+	mu           sync.Mutex
+	fenster      time.Duration
+	fensterStart time.Time
+	medien       uint64
+	verloren     map[uint16]struct{}
+	// Verlustanteil in Promille, ab dem die Paritaet laeuft.
+	//
+	// Vorgabe 20 (= 2 Prozent), und das ist ABSICHTLICH hoeher als die
+	// 1-Prozent-Grenze, unterhalb derer libwebrtc seine eigene FEC abschaltet.
+	// Gemessen am 2026-08-04: der Grundverlust der Laborstrecke liegt in den
+	// ruhigen Abschnitten bei 2 bis 9 Promille. Eine Schwelle von 10 sitzt
+	// mitten darin, das Tor kippt staendig und spart fast nichts (19,53 statt
+	// 19,86 Prozent Aufschlag); bei 20 bleiben 14,99. Der richtige Wert haengt
+	// also am Grundverlust der Leitung — ein zu tief gesetzter macht die
+	// Regelung wirkungslos, ohne dass irgendetwas scheitert.
+	promille uint64
+
+	// Nur fuer die Diagnose-Zeile beim Sitzungsende.
+	gemeldet      atomic.Uint64
+	durchgelassen atomic.Uint64
+	unterdrueckt  atomic.Uint64
+}
+
+// fensterPruefen setzt das Messfenster weiter. Ruft nur auf, wer `mu` haelt.
+func (g *pulseFecTor) fensterPruefen(jetzt time.Time) {
+	if jetzt.Sub(g.fensterStart) < g.fenster {
+		return
+	}
+	g.fensterStart = jetzt
+	g.medien = 0
+	clear(g.verloren)
+}
+
+// medienPaket zaehlt die Bezugsgroesse mit: ohne sie waere die Verlustrate
+// eine Zahl ohne Nenner, und genau daran ist im Labor schon eine ganze
+// Messreihe gescheitert („61805 Wiederholungen" waren 78 Kopien je Paket).
+func (g *pulseFecTor) medienPaket() {
+	jetzt := time.Now()
+	g.mu.Lock()
+	g.fensterPruefen(jetzt)
+	g.medien++
+	g.mu.Unlock()
+}
+
+func (g *pulseFecTor) melden(seqnos []uint16) {
+	if len(seqnos) == 0 {
+		return
+	}
+	g.gemeldet.Add(uint64(len(seqnos)))
+	jetzt := time.Now()
+
+	g.mu.Lock()
+	g.fensterPruefen(jetzt)
+	for _, sn := range seqnos {
+		g.verloren[sn] = struct{}{}
+	}
+	ueber := g.medien > 0 && uint64(len(g.verloren))*1000 >= g.medien*g.promille
+	g.mu.Unlock()
+
+	if ueber {
+		g.letzterVerlust.Store(jetzt.UnixNano())
+	}
+}
+
+// meldenAnteil ist das Auffangnetz fuer einen Empfaenger, der KEIN NACK
+// aushandelt: der meldet nie eine Luecke, und das Tor bliebe fuer ihn ewig zu.
+// `fraction lost` taugt als ALLEINIGE Regelgroesse nicht (s.o.), als zweiter
+// Melder aber sehr wohl. Der Wert ist Anteil mal 256 (RFC 3550 §6.4.1).
+func (g *pulseFecTor) meldenAnteil(fractionLost uint8) {
+	if uint64(fractionLost)*1000/256 < g.promille {
+		return
+	}
+	g.gemeldet.Add(1)
+	g.letzterVerlust.Store(time.Now().UnixNano())
+}
+
+func (g *pulseFecTor) durchlassen() bool {
+	if time.Since(g.beginn) < g.anlauf {
+		return true
+	}
+	letzter := g.letzterVerlust.Load()
+
+	return letzter != 0 && time.Since(time.Unix(0, letzter)) < g.haltezeit
+}
+
+// pulseFecFilter verwirft Paritaetspakete, solange das Tor zu ist.
+type pulseFecFilter struct {
+	interceptor.NoOp
+	tor *pulseFecTor
+}
+
+func (f *pulseFecFilter) BindLocalStream(
+	info *interceptor.StreamInfo, writer interceptor.RTPWriter,
+) interceptor.RTPWriter {
+	// Der Paritaets-Nutzlasttyp wird AUSGEHANDELT, er ist keine Konstante:
+	// Chromium bietet 49 an, unser nativer Player 110. Ein Filter, der gegen
+	// die eigene Konstante prueft, laesst deshalb beim Browser alles durch —
+	// genau so ist die erste Fassung wirkungslos geblieben, ohne zu scheitern.
+	//
+	// `PayloadTypeForwardErrorCorrection` steht in der StreamInfo des
+	// MEDIENstroms und ist dasselbe Feld, an dem pions Erzeuger entscheidet, ob
+	// er ueberhaupt Paritaet baut (encoder_interceptor.go). Ist es 0, gibt es
+	// fuer diesen Strom keine Paritaet und nichts zu filtern.
+	fecPT := uint8(info.PayloadTypeForwardErrorCorrection)
+	if fecPT == 0 {
+		return writer
+	}
+
+	return interceptor.RTPWriterFunc(
+		func(header *rtp.Header, payload []byte, attributes interceptor.Attributes) (int, error) {
+			if header.PayloadType != fecPT {
+				f.tor.medienPaket()
+			} else {
+				if !f.tor.durchlassen() {
+					// Still schlucken. Der Empfaenger prueft den Paritaetsstrom
+					// nicht auf Luecken (er schluesselt ueber die
+					// Basis-Sequenznummer im Paritaetskopf), sieht also schlicht
+					// keine Paritaet und repariert nicht — gefahrlos.
+					f.tor.unterdrueckt.Add(1)
+
+					return len(payload), nil
+				}
+				f.tor.durchgelassen.Add(1)
+			}
+
+			return writer.Write(header, payload, attributes)
+		})
+}
+
+type pulseFecFilterFactory struct{ tor *pulseFecTor }
+
+func (f *pulseFecFilterFactory) NewInterceptor(_ string) (interceptor.Interceptor, error) {
+	return &pulseFecFilter{tor: f.tor}, nil
+}
+
+// pulseFecAdaptiv liest die Regelung aus der Umgebung.
+//
+// Voreinstellung AUS: ohne Zutun geht die Paritaet immer hinaus, also genau wie
+// bisher gemessen.
+//
+//	PULSE_FLEXFEC_ADAPTIV=1        Regelung ein
+//	PULSE_FLEXFEC_HALTEZEIT_S=10   wie lange nach dem letzten NACK offen bleiben
+//	PULSE_FLEXFEC_ANLAUF_S=5       wie lange am Sitzungsanfang immer offen
+func pulseFecAdaptiv() (an bool, tor *pulseFecTor) {
+	if os.Getenv("PULSE_FLEXFEC_ADAPTIV") != "1" {
+		return false, nil
+	}
+	sekunden := func(name string, vorgabe float64) time.Duration {
+		v, err := strconv.ParseFloat(os.Getenv(name), 64)
+		if err != nil || v < 0 {
+			v = vorgabe
+		}
+
+		return time.Duration(v * float64(time.Second))
+	}
+	promille := uint64(20)
+	if v, err := strconv.ParseUint(os.Getenv("PULSE_FLEXFEC_SCHWELLE_PROMILLE"), 10, 32); err == nil {
+		promille = v
+	}
+	jetzt := time.Now()
+
+	return true, &pulseFecTor{
+		beginn:       jetzt,
+		fensterStart: jetzt,
+		haltezeit:    sekunden("PULSE_FLEXFEC_HALTEZEIT_S", 10),
+		anlauf:       sekunden("PULSE_FLEXFEC_ANLAUF_S", 5),
+		fenster:      sekunden("PULSE_FLEXFEC_FENSTER_S", 2),
+		promille:     promille,
+		verloren:     make(map[uint16]struct{}),
+	}
 }
 
