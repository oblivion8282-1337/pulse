--- a/internal/protocols/webrtc/outbound_track.go
+++ b/internal/protocols/webrtc/outbound_track.go
@@ -76,12 +76,40 @@ func (t *OutboundTrack) setup(p *PeerConnection) error {
 			// Upstream discards these packets, so the request died at this
 			// line and the reader stayed frozen forever whenever the
 			// publisher was not emitting periodic key frames. Hand it on.
-			if p.OnKeyFrameRequest != nil && t.isVideo() {
-				for _, pkt := range pkts {
-					switch pkt.(type) {
-					case *rtcp.PictureLossIndication, *rtcp.FullIntraRequest:
+			for _, pkt := range pkts {
+				switch v := pkt.(type) {
+				case *rtcp.PictureLossIndication, *rtcp.FullIntraRequest:
+					if p.OnKeyFrameRequest != nil && t.isVideo() {
 						p.OnKeyFrameRequest()
 					}
+
+				case *rtcp.TransportLayerNack:
+					// Pulse: DIE Regelgroesse des Paritaets-Tors. Der NACK
+					// meldet den ROHEN Verlust — er entsteht, sobald der
+					// Empfaenger eine Luecke sieht, also BEVOR irgendetwas
+					// repariert wurde, und nennt die Sequenznummern einzeln.
+					// `fraction lost` aus dem Receiver Report kann das nicht:
+					// er wird erst nach der Nachlieferung gebildet, ist auf
+					// 1/256 gequantelt und kommt nur einmal je Report-Zyklus.
+					if p.fecTor != nil && t.isVideo() {
+						var seqnos []uint16
+						for i := range v.Nacks {
+							seqnos = append(seqnos, v.Nacks[i].PacketList()...)
+						}
+						p.fecTor.melden(seqnos)
+					}
+
+				case *rtcp.ReceiverReport:
+					// Auffangnetz fuer einen Empfaenger, der KEIN NACK
+					// aushandelt: der meldet nie eine Luecke, und das Tor
+					// bliebe fuer ihn ewig zu. `fraction lost` taugt als
+					// alleinige Regelgroesse nicht (s. `pulseFecTor`), als
+					// zweiter Melder neben dem NACK aber sehr wohl.
+					if p.fecTor != nil && t.isVideo() {
+						for _, r := range v.Reports {
+							p.fecTor.meldenAnteil(r.FractionLost)
+						}
+					}
 				}
 			}
 		}
