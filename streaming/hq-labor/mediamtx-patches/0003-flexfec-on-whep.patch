+	// Nutzlasttyp der Paritaetspakete. 96 und 97 vergibt MediaMTX an die
+	// Medienspuren selbst (96+i weiter unten), 110 ist frei.
+	pulseFlexFECPayloadType = 110
 )
 
+// pulseFlexFECConfig liest die Paritaets-Einstellung aus der Umgebung.
+//
+// Voreinstellung AUS: ohne Zutun verhaelt sich der Server exakt wie upstream.
+// Eingeschaltet werden je `PULSE_FLEXFEC_MEDIA` Medienpaketen
+// `PULSE_FLEXFEC_FEC` Paritaetspakete erzeugt — 10 und 2 ergeben die 20 %,
+// die sich bei Sunshine als Voreinstellung bewaehrt haben. pion selbst kommt
+// mit 5 und 2, also 40 %.
+//
+// Die Paritaet kommt OBENDRAUF und nimmt der Videobitrate nichts weg: der
+// Encoder sitzt im Sender und weiss von alledem nichts, der Interceptor haengt
+// die zusaetzlichen Pakete lediglich an den ausgehenden Strom an. Wer mit
+// 4000 kbps sendet, sendet danach 4000 kbps Video plus rund 800 kbps Reserve.
+func pulseFlexFECConfig() (an bool, medien uint32, paritaet uint32) {
+	zahl := func(name string, vorgabe uint32) uint32 {
+		v, err := strconv.ParseUint(os.Getenv(name), 10, 32)
+		if err != nil || v == 0 {
+			return vorgabe
+		}
+		return uint32(v)
+	}
+	return os.Getenv("PULSE_FLEXFEC") == "1",
+		zahl("PULSE_FLEXFEC_MEDIA", 10),
+		zahl("PULSE_FLEXFEC_FEC", 2)
+}
