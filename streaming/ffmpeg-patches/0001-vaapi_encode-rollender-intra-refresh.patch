From 7dc10c09432d3514453885c48bd816204f3b0dac Mon Sep 17 00:00:00 2001
From: Michael de Meyer <249562202+oblivion8282-1337@users.noreply.github.com>
Date: Sat, 1 Aug 2026 00:12:30 +0200
Subject: [PATCH] avcodec/vaapi_encode: add rolling intra refresh

Periodic key frames are expensive on a low latency stream: they arrive as
one large frame that has to be squeezed through the same pipe as everything
else, and losing one of them costs everything until the next. A rolling
intra refresh spreads the same information over the whole cycle instead.

VA-API has had the pieces for this since 1.1 (VAConfigAttribEncIntraRefresh
and VAEncMiscParameterRIR), but unlike NVENC, where the driver runs the wave
once a period is configured, VA-API expects the application to place the
refreshed region in every single picture. That is what this does.

Adds two options to the VAAPI encoders, intra_refresh and
intra_refresh_period. Turning the refresh on stops the periodic key frames,
the same way h264_nvenc does; an explicitly requested key frame is still
encoded and restarts the cycle.

The wave is advanced by blocks_in_frame/period blocks per picture, kept
exact over the cycle rather than rounded per picture: with a cycle longer
than there are blocks - 1080p in superblocks is only 17 rows against a
120 picture cycle - rounding up to one block per picture would silently
turn every long cycle into a 17 picture one.

Implemented for H.264 and AV1, where the unit the driver counts rows in is
unambiguous (a macroblock, and a superblock). HEVC is left out on purpose:
the CTB size is chosen by the encoder, drivers do not agree on which value
they count in, and a mismatch does not fail - it silently refreshes only
part of the frame.

Tested on Mesa 26.1.5 / radeonsi (Radeon 780M, VCN 4) with AV1 and H.264.
---
 libavcodec/vaapi_encode.c      | 148 +++++++++++++++++++++++++++++++++
 libavcodec/vaapi_encode.h      |  45 +++++++++-
 libavcodec/vaapi_encode_av1.c  |   6 ++
 libavcodec/vaapi_encode_h264.c |   3 +
 4 files changed, 201 insertions(+), 1 deletion(-)

diff --git a/libavcodec/vaapi_encode.c b/libavcodec/vaapi_encode.c
index 0e50602..ed92c34 100644
--- a/libavcodec/vaapi_encode.c
+++ b/libavcodec/vaapi_encode.c
@@ -587,6 +587,51 @@ static int vaapi_encode_issue(AVCodecContext *avctx,
     }
 #endif
 
+#if VA_CHECK_VERSION(1, 1, 0)
+    if (ctx->ir_flags) {
+        // Drivers apply this to the picture at hand only, so it has to be
+        // sent again for every one of them.
+        if (base_pic->type == FF_HW_PICTURE_TYPE_IDR ||
+            base_pic->type == FF_HW_PICTURE_TYPE_I) {
+            // An intra picture has just refreshed everything there is, so
+            // the wave starts over behind it.
+            ctx->ir_offset = 0;
+            ctx->ir_debt   = 0;
+        } else {
+            // Move the wave on by ir_blocks/ir_period blocks, kept exact
+            // over the cycle rather than rounded per picture: a cycle
+            // longer than there are blocks leaves pictures without any
+            // refresh, and a shorter one refreshes several blocks at once.
+            // Rounding here instead would silently turn every long cycle
+            // into one of ir_blocks pictures.
+            ctx->ir_debt += ctx->ir_blocks;
+
+            if (ctx->ir_debt >= ctx->ir_period) {
+                int region = ctx->ir_debt / ctx->ir_period;
+                VAEncMiscParameterRIR param_rir = {
+                    .rir_flags.value            = ctx->ir_flags,
+                    .intra_insertion_location   = ctx->ir_offset,
+                    .intra_insert_size          = region,
+                    .qp_delta_for_inserted_intra = 0,
+                };
+
+                ctx->ir_debt -= region * ctx->ir_period;
+
+                err = vaapi_encode_make_misc_param_buffer(avctx, pic,
+                                                          VAEncMiscParameterTypeRIR,
+                                                          &param_rir,
+                                                          sizeof(param_rir));
+                if (err < 0)
+                    goto fail;
+
+                ctx->ir_offset += region;
+                if (ctx->ir_offset >= ctx->ir_blocks)
+                    ctx->ir_offset = 0;
+            }
+        }
+    }
+#endif
+
     vas = vaBeginPicture(ctx->hwctx->display, ctx->va_context,
                          pic->input_surface);
     if (vas != VA_STATUS_SUCCESS) {
@@ -2019,6 +2064,103 @@ static av_cold int vaapi_encode_init_quality(AVCodecContext *avctx)
     return 0;
 }
 
+static av_cold int vaapi_encode_init_intra_refresh(AVCodecContext *avctx)
+{
+#if VA_CHECK_VERSION(1, 1, 0)
+    FFHWBaseEncodeContext *base_ctx = avctx->priv_data;
+    VAAPIEncodeContext         *ctx = avctx->priv_data;
+    VAConfigAttrib attr = { VAConfigAttribEncIntraRefresh };
+    int block_size = ctx->codec->intra_refresh_block_size;
+    int period;
+    VAStatus vas;
+
+    if (!ctx->intra_refresh)
+        return 0;
+
+    if (!block_size) {
+        av_log(avctx, AV_LOG_ERROR, "Intra refresh is not implemented for "
+               "this codec.\n");
+        return AVERROR(ENOSYS);
+    }
+
+    if (base_ctx->gop_size <= 1) {
+        av_log(avctx, AV_LOG_ERROR, "Intra refresh needs inter frames to "
+               "spread the refresh over.\n");
+        return AVERROR(EINVAL);
+    }
+
+    // The wave moves on once per encoded picture, so in encode order.  With
+    // B-frames that is not display order, and the refreshed regions would
+    // arrive out of sequence.
+    if (base_ctx->b_per_p > 0) {
+        av_log(avctx, AV_LOG_ERROR, "Intra refresh cannot be used together "
+               "with B-frames.\n");
+        return AVERROR(EINVAL);
+    }
+
+    vas = vaGetConfigAttributes(ctx->hwctx->display,
+                                ctx->va_profile,
+                                ctx->va_entrypoint,
+                                &attr, 1);
+    if (vas != VA_STATUS_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to query intra refresh "
+               "config attribute: %d (%s).\n", vas, vaErrorStr(vas));
+        return AVERROR_EXTERNAL;
+    }
+
+    if (attr.value == VA_ATTRIB_NOT_SUPPORTED || !attr.value) {
+        av_log(avctx, AV_LOG_ERROR, "Driver does not support intra "
+               "refresh.\n");
+        return AVERROR(ENOSYS);
+    }
+
+    // Rows are preferred because they follow coding order, so the refreshed
+    // area stays contiguous in the bitstream.
+    if (attr.value & VA_ENC_INTRA_REFRESH_ROLLING_ROW) {
+        ctx->ir_flags  = VA_ENC_INTRA_REFRESH_ROLLING_ROW;
+        ctx->ir_blocks = (avctx->height + block_size - 1) / block_size;
+    } else if (attr.value & VA_ENC_INTRA_REFRESH_ROLLING_COLUMN) {
+        ctx->ir_flags  = VA_ENC_INTRA_REFRESH_ROLLING_COLUMN;
+        ctx->ir_blocks = (avctx->width + block_size - 1) / block_size;
+    } else {
+        av_log(avctx, AV_LOG_ERROR, "Driver supports intra refresh, but "
+               "neither of the rolling modes (attribute %#x).\n", attr.value);
+        return AVERROR(ENOSYS);
+    }
+
+    period = ctx->intra_refresh_period > 0 ? ctx->intra_refresh_period
+                                           : base_ctx->gop_size;
+    ctx->ir_period = period;
+    ctx->ir_debt   = 0;
+    ctx->ir_offset = 0;
+
+    // The refresh takes the place of the periodic key frames - leaving them
+    // in would pay for the same thing twice.  A key frame that is explicitly
+    // asked for later (AV_FRAME_FLAG_KEY, or a forced key frame) is still
+    // encoded, and restarts the cycle.
+    base_ctx->gop_size = INT_MAX;
+
+    av_log(avctx, AV_LOG_VERBOSE, "Using rolling intra refresh by %s: "
+           "%d blocks, one cycle every %d pictures (%.2f blocks per "
+           "picture).\n",
+           ctx->ir_flags == VA_ENC_INTRA_REFRESH_ROLLING_ROW ? "row" : "column",
+           ctx->ir_blocks, ctx->ir_period,
+           (double)ctx->ir_blocks / ctx->ir_period);
+
+    return 0;
+#else
+    VAAPIEncodeContext *ctx = avctx->priv_data;
+
+    if (ctx->intra_refresh) {
+        av_log(avctx, AV_LOG_ERROR, "Intra refresh is not supported with "
+               "this VAAPI version.\n");
+        return AVERROR(ENOSYS);
+    }
+
+    return 0;
+#endif
+}
+
 static av_cold int vaapi_encode_init_roi(AVCodecContext *avctx)
 {
 #if VA_CHECK_VERSION(1, 0, 0)
@@ -2215,6 +2357,12 @@ av_cold int ff_vaapi_encode_init(AVCodecContext *avctx)
     if (err < 0)
         goto fail;
 
+    // After the GOP structure, because it replaces the periodic key frames
+    // that were set up there.
+    err = vaapi_encode_init_intra_refresh(avctx);
+    if (err < 0)
+        goto fail;
+
     if (avctx->compression_level >= 0) {
         err = vaapi_encode_init_quality(avctx);
         if (err < 0)
diff --git a/libavcodec/vaapi_encode.h b/libavcodec/vaapi_encode.h
index 1fa1e99..c047d5c 100644
--- a/libavcodec/vaapi_encode.h
+++ b/libavcodec/vaapi_encode.h
@@ -162,6 +162,14 @@ typedef struct VAAPIEncodeContext {
     // Block Level based bitrate control.
     int             blbrc;
 
+    // Use a rolling intra refresh instead of periodic key frames.
+    int             intra_refresh;
+
+    // Number of frames one full refresh cycle takes.  Zero means to use
+    // the key frame interval, so that the refresh takes as long as the
+    // GOP it replaces.
+    int             intra_refresh_period;
+
     // Explicitly-set QP, for use with the "qp" options.
     // (Forces CQP mode when set, overriding everything else.)
     int             explicit_qp;
@@ -245,6 +253,26 @@ typedef struct VAAPIEncodeContext {
     // Location of the i-th tile row boundary.
     int row_bd[MAX_TILE_ROWS + 1];
 
+    // Rolling intra refresh state, set up by
+    // vaapi_encode_init_intra_refresh().  Unlike NVENC, where the driver
+    // runs the wave itself once a period is set, VA-API expects the
+    // application to place the refreshed region in every single picture -
+    // so the position has to be tracked here.
+    // Which of the rolling modes was picked (a VA_ENC_INTRA_REFRESH_* value
+    // to put into VAEncMiscParameterRIR.rir_flags), zero if unused.
+    unsigned int    ir_flags;
+    // Number of coding blocks across the direction being refreshed.
+    int             ir_blocks;
+    // Number of pictures one full cycle over those blocks takes.
+    int             ir_period;
+    // Blocks owed to the current picture, carried between pictures so that
+    // the cycle keeps its length even when a picture refreshes no block at
+    // all (a long cycle over few blocks) or several of them (a short cycle
+    // over many).
+    int             ir_debt;
+    // Position of the refreshed region in the next picture that has one.
+    int             ir_offset;
+
     // Maximum number of regions supported by the driver.
     int             roi_max_regions;
     // Quantisation range for offset calculations.  Set by codec-specific
@@ -278,6 +306,12 @@ typedef struct VAAPIEncodeType {
     // factor depending on RC mode.
     int default_quality;
 
+    // Size in luma samples of the block that intra-refresh rows and columns
+    // are counted in: a macroblock for H.264, a superblock or CTB otherwise.
+    // Zero if intra refresh is not implemented for this codec, in which case
+    // asking for it fails at init.
+    int intra_refresh_block_size;
+
     // Determine encode parameters like block sizes for surface alignment
     // and slices. This may need to query the profile and entrypoint,
     // which will be available when this function is called. If not set,
@@ -360,7 +394,16 @@ int ff_vaapi_encode_close(AVCodecContext *avctx);
     { "max_frame_size", \
       "Maximum frame size (in bytes)",\
       OFFSET(common.max_frame_size), AV_OPT_TYPE_INT, \
-      { .i64 = 0 }, 0, INT_MAX / 8, FLAGS }
+      { .i64 = 0 }, 0, INT_MAX / 8, FLAGS }, \
+    { "intra_refresh", \
+      "Use a rolling intra refresh instead of periodic key frames", \
+      OFFSET(common.intra_refresh), AV_OPT_TYPE_BOOL, \
+      { .i64 = 0 }, 0, 1, FLAGS }, \
+    { "intra_refresh_period", \
+      "Number of frames in one intra refresh cycle " \
+      "(0 = the key frame interval)", \
+      OFFSET(common.intra_refresh_period), AV_OPT_TYPE_INT, \
+      { .i64 = 0 }, 0, INT_MAX, FLAGS }
 
 #define VAAPI_ENCODE_RC_MODE(name, desc) \
     { #name, desc, 0, AV_OPT_TYPE_CONST, { .i64 = RC_MODE_ ## name }, \
diff --git a/libavcodec/vaapi_encode_av1.c b/libavcodec/vaapi_encode_av1.c
index 9d837f5..81e6674 100644
--- a/libavcodec/vaapi_encode_av1.c
+++ b/libavcodec/vaapi_encode_av1.c
@@ -850,6 +850,12 @@ static const VAAPIEncodeType vaapi_encode_type_av1 = {
     .flags           = FF_HW_FLAG_B_PICTURES | FLAG_TIMESTAMP_NO_DELAY,
     .default_quality = 25,
 
+    // Intra refresh is counted in superblocks.  64 is what the AMD driver
+    // counts in (ac_vcn_enc.h: PIPE_AV1_ENC_SB_SIZE), and the only value
+    // this has been tested against; it is also the superblock size unless
+    // use_128x128_superblock is turned on.
+    .intra_refresh_block_size = 64,
+
     .get_encoder_caps = &vaapi_encode_av1_get_encoder_caps,
     .configure        = &vaapi_encode_av1_configure,
 
diff --git a/libavcodec/vaapi_encode_h264.c b/libavcodec/vaapi_encode_h264.c
index 27f6551..8f1d783 100644
--- a/libavcodec/vaapi_encode_h264.c
+++ b/libavcodec/vaapi_encode_h264.c
@@ -966,6 +966,9 @@ static const VAAPIEncodeType vaapi_encode_type_h264 = {
 
     .default_quality       = 20,
 
+    // Intra refresh is counted in macroblocks.
+    .intra_refresh_block_size = 16,
+
     .configure             = &vaapi_encode_h264_configure,
 
     .picture_priv_data_size = sizeof(VAAPIEncodeH264Picture),
