# Database
POSTGRES_USER=dcc
POSTGRES_PASSWORD=change-me-to-random-hex
POSTGRES_DB=dcc
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Redis
REDIS_URL=redis://localhost:6380/0

# JWT (RS256)
JWT_PRIVATE_KEY_FILE=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_FILE=./secrets/jwt_public.pem
JWT_ISSUER=dcc-auth
JWT_AUDIENCE=dcc
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Service URLs (intra-service via docker-compose hostnames)
AUTH_JWKS_URL=http://auth:8000/.well-known/jwks.json

# Worker IDs for snowflakes (each service gets one)
SNOWFLAKE_WORKER_ID_AUTH=1
SNOWFLAKE_WORKER_ID_CHAT=2
SNOWFLAKE_WORKER_ID_VOICE=3

# CORS - dev origins
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LiveKit (Phase E - optional)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
LIVEKIT_URL=ws://localhost:7880

# MinIO (S3-compatible object store for message attachments)
# Both endpoints point to the same localhost service in dev — no nginx proxy
# layer. In prod they diverge (internal docker DNS vs. public domain).
S3_INTERNAL_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pulse-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Web-Push (VAPID) — generate persistent keys with `vapid` CLI or `cryptography`:
#   from cryptography.hazmat.primitives.asymmetric import ec
#   from cryptography.hazmat.primitives.serialization import ...
# Without these, chat-gateway will auto-generate on startup and persist to
# ./data/vapid.json (NOT persistent across docker restarts without a volume).
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Token-cleanup intervals (auth-svc). Defaults sind production-tauglich, aber overrides für Debugging/kürzere Aufbewahrung:
# TOKEN_CLEANUP_INTERVAL_SECONDS=86400
# TOKEN_CLEANUP_GRACE_DAYS_EXPIRED=7
# TOKEN_CLEANUP_GRACE_DAYS_REVOKED=30

# Web-Push subscription cleanup (chat-gateway). Default: idle subs werden nach 60 Tagen gelöscht.
# PUSH_SUBSCRIPTION_IDLE_DAYS=60
