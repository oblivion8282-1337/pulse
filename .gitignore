# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# Node
node_modules/
.pnpm-store/
.svelte-kit/
.vite/
*.tsbuildinfo

# SvelteKit build outputs
web/build/
web/.svelte-kit/

# electron-builder Windows-Artefakte (Pulse-<version>-portable.exe)
desktop/release/

# Secrets / Env
secrets/*
!secrets/.gitignore
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Playwright
playwright-report/
test-results/
blob-report/
playwright/.cache/

# uv lock backup
uv.lock.backup

# Claude Code: geteilte Projekt-Settings + Hooks committen, lokales ignorieren.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json

# Uploaded files (avatars, guild icons, …) — never check in user content.
services/*/uploads/

# Service-runtime state (auto-generated VAPID keys etc.) — never commit.
services/*/data/
# pytest aus repo-root erzeugt das auch hier (CWD-relativer Default).
/data/

# Streaming (T2) — generierte MediaMTX-Config + Stream-Key. NIEMALS einchecken.
# Das Template streaming/server/mediamtx.yml.template ist ok (Placeholder-Key).
streaming/server/mediamtx.yml
streaming/server/.stream-key

# Flatpak repo signing key (packaging/publish.fish). Private key — NIEMALS einchecken.
# Back it up separately: losing it means the friend's installed app rejects updates.
packaging/.gpg/

# Production deploy — server-side secrets. NIEMALS einchecken.
# infra/prod/.env is also matched by the global `.env` rule above; explicit here.
# Committed: infra/prod/.env.example, docker-compose.yml, mediamtx.yml,
# livekit.yaml, web-nginx.conf, Caddyfile.pulse.snippet.
infra/prod/.env
infra/prod/secrets/
infra/prod/certs/

# Local-dev MediaMTX TLS material — same shape as the prod certs/ above,
# self-signed key generated on-host. Never commit the private key.
streaming/server/certs/

# Rust-Build-Cache der Fernsteuerungs-Crate (~1 GB, webrtc-rs zieht einen
# riesigen Abhängigkeitsbaum). Die Crate bringt zwar ihre eigene `/target`-
# .gitignore mit — die ist aber selbst versioniert und existiert nur auf dem
# Feature-Branch. Auf `main` fehlt sie, der Cache taucht dort als untracked auf
# und ein `git add -A` würde ihn stagen. Hier zentral, damit die Regel auf
# JEDEM Branch gilt. (Das `/target-*` weiter unten ist etwas anderes und
# greift bei verschachtelten Verzeichnissen nicht.)
/streaming/pulse-remote-webrtc/target/

# Rust-Build-Cache des nativen HQ-Players — gleiche Begründung wie eine Zeile
# höher (webrtc-rs + wgpu + FFmpeg-Bindings, ~2 GB, 8000+ Dateien).
/streaming/pulse-player/target/

# Bau-Cache des Windows-Input-PoC (~54 MB). Dieselbe Falle wie eine Zeile
# darueber, nur mit dem Quelltext auf `feat/remote-control-windows`: Der PoC
# bringt seine eigene `/target`-.gitignore mit, die ist aber mitversioniert und
# verschwindet beim Wechsel auf einen Branch ohne ihn. Zurueck bleibt das
# ignorierte Bau-Verzeichnis, das dann NICHT mehr ignoriert ist.

# electron-packager output (Pulse-<platform>-<arch>{/,.zip})
Pulse-*-*/
Pulse-*-*.zip

# Local dev artifacts (CDP-monitor + electron log capture, used to debug the
# Windows HQ-sidecar pipeline) — never commit.
/target-*

# Android sideload/test builds (large binaries — built on demand, never commit).
# The mobile/ Capacitor project tracks its source; build/ + .gradle are covered
# by the global `build/` rule above and mobile/android/.gitignore.
*.apk

# Lokale Analyse-Artefakte (simplify-scan u.ä.)
.cache/
.superpowers/
graphify-out/
# App-Hosting: gebündelte Podman-Binaries (CI/dist lädt sie, nie committen)
desktop/resources-podman/*
!desktop/resources-podman/README.md
desktop/resources-podman-mac/*
!desktop/resources-podman-mac/README.md
