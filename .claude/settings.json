{
  "_comment": "Geteilte Projekt-Settings f\u00fcr Claude Code (auf jedem Rechner). Lokale, ungeteilte Overrides geh\u00f6ren in .claude/settings.local.json (gitignored).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/graphify-hinweis.mjs bash 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/graphify-hinweis.mjs lesen 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}