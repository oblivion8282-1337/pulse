[Desktop Entry]
Type=Application
Name=Pulse
GenericName=Chat & Voice
Comment=Web-first chat, voice and high-quality screen streaming
Exec=pulse %u
Icon=com.howispulse.Pulse
Terminal=false
MimeType=x-scheme-handler/pulse;
Categories=Network;Chat;InstantMessaging;AudioVideo;
Keywords=chat;voice;voip;stream;screen share;discord;
StartupNotify=true
StartupWMClass=com.howispulse.Pulse
