{
  "name": "@dcc/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm paraglide:compile",
    "dev": "vite dev --port 5173 --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale",
    "check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "@svelte-put/shortcut": "^4.1.0",
    "dompurify": "^3.4.2",
    "hash-wasm": "^4.12.0",
    "livekit-client": "^2.18.9",
    "marked": "^18.0.3",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@inlang/paraglide-js": "^2.18.1",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.14.0",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.7.5",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.11"
  }
