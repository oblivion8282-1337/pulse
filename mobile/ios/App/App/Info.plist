<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Pulse</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Usage-Strings (Pflicht): ohne sie killt iOS den Prozess beim ersten
	     LiveKit-Mic-/Kamera-Zugriff statt nur einen TCC-Dialog zu zeigen.
	     Texte analog zu den TCC-Strings der Mac-App (desktop/electron-builder.yml,
	     extendInfo). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Pulse nutzt dein Mikrofon für Sprachkanäle und Anrufe.</string>
	<key>NSCameraUsageDescription</key>
	<string>Pulse nutzt die Kamera für Videoanrufe und Kamerabilder im Chat.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pulse greift auf deine Fotomediathek zu, um Bilder in Chats zu teilen.</string>
	<!-- Self-Host im Heimnetz: iOS blockt LAN-Verbindungen still, wenn diese
	     Erläuterung fehlt (der Dialog fragt beim ersten Aufbau). Ohne den Key
	     wäre der eigene Server zuhause unsichtbar. -->
	<!-- NSFaceIDUsageDescription ist PFLICHT, sobald LocalAuthentication
	     gerufen wird: ohne den Eintrag beendet iOS die App beim ersten
	     Face-ID-Aufruf — kein Dialog, kein Fehler, Absturz. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Pulse uses Face ID to unlock the app.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Pulse verbindet sich mit deinem Pulse-Server im Heimnetzwerk (Self-Host).</string>
	<!-- Hintergrund-Ton: Sprachkanäle und Watch-/Stream-Ton laufen weiter,
	     wenn das Display gesperrt wird (Etappe 3, Item 23). Ohne diesen
	     Mode stoppt iOS die Audio-Session beim Sperren. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<!-- voip: Pflicht für PushKit (iOS-Liste Punkt 40). Ohne diesen
		     Eintrag liefert iOS KEINEN einzigen VoIP-Push aus — und zwar
		     ohne Fehlermeldung, der Push verschwindet einfach. -->
		<string>voip</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- ALLE DREI LAGEN SIND ABSICHT, und sie bedeuten NICHT, dass die App
	     dreht. Der Riegel sitzt zur Laufzeit im AppDelegate
	     (supportedInterfaceOrientationsFor) und gibt quer nur frei, solange das
	     Web es fürs Stream-Vollbild anfordert — OrientationLockPlugin.swift,
	     JS-Seite web/src/lib/platform/orientation.ts. Der Messenger bleibt also
	     hochkant wie zuvor.
	     Hier stand bis zum 2026-10-08 nur Portrait, und das war der Grund, warum
	     das Video-Vollbild am iPhone nicht mitdrehte: iOS stellt das Vollbild
	     eines <video> ausschliesslich in Lagen dar, die die App DEKLARIERT —
	     eine nicht deklarierte Lage kann kein Plugin und kein Webcode
	     nachträglich freigeben.
	     Kopfüber fehlt bewusst: ein Telefon zeigt Video nicht auf dem Kopf. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
