<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bughunt Runde 45: usesCleartextTraffic=false bewusst EXPLIZIT —
         das generierte Manifest capacitor-cordova-android-plugins setzt
         "true" und gewinnt sonst den Merge gegen capacitor.config.json
         ("cleartext": false) fuer einen E2EE-Client. -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        tools:replace="android:usesCleartextTraffic"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links (Übergabe P1.8): https-Links auf howispulse.com/app
                 öffnen die App statt dem Browser. autoVerify verlangt die
                 assetlinks.json unter https://howispulse.com/.well-known/ —
                 ohne sie (oder mit falschem Fingerabdruck) zeigt Android den
                 Disambiguator, der Link funktioniert trotzdem. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="howispulse.com" />
            </intent-filter>

            <!-- Share-Target (Übergabe P1.8): Text und Bilder aus anderen
                 Apps teilen. Empfang in MainActivity, Weitergabe an die
                 WebView über ShareReceiverPlugin. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Hält die WebView-Mic-Aufnahme bei Screen-Lock am Leben. Start/Stop
             ist an einen aktiven Voice-Call gebunden (MainActivity.setMicServiceActive),
             nicht an den App-Start — sonst liefe Pulse dauerhaft im Hintergrund. -->
        <service
            android:name=".MicForegroundService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!-- Klingelnder Anruf als Sperrbildschirm-Notification (Anrufe-Epic E).
             Start/Stopp via AnrufPlugin (Web: call_klingelt / Entscheidung). -->
        <service
            android:name=".CallForegroundService"
            android:foregroundServiceType="phoneCall"
            android:exported="false" />

        <!-- Annehmen/Ablehnen direkt aus der Notification, auch über dem
             Sperrbildschirm (entscheidet zurück an die WebView). -->
        <receiver
            android:name=".CallForegroundService$AktionsEmpfaenger"
            android:exported="false" />
        <!-- Chat-Benachrichtigung: Aktion „Als gelesen markieren“ (HinweisePlugin). -->
        <receiver
            android:name=".HinweiseAktionReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Bughunt Runde 45: ohne CAMERA-Eintrag ist die Runtime-Permission
         automatische verweigert — Capacitors onPermissionRequest startet
         fuer VIDEO_CAPTURE den Laufzeit-Dialog, der ohne Manifest-Eintrag
         ohne Dialog ablehnt. Jede getUserMedia({video}) im APK starb mit
         NotAllowedError (Mikrofon ging, Kamera nie). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Ohne MODIFY_AUDIO_SETTINGS gibt Android das Mic nicht an den WebView. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- FGS-Notification ist ab Android 13 (API 33) eine Runtime-Permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Anrufe-Epic E: eingehende Anrufe über dem Sperrbildschirm.
         USE_FULL_SCREEN_INTENT startet bei Sperrbildschirm die MainActivity im
         Vollbild; FOREGROUND_SERVICE_PHONE_CALL + MANAGE_OWN_CALLS sind die
         Voraussetzung für den phoneCall-FGS (CallStyle-Notification, ab API 34
         typpflichtig). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
</manifest>
