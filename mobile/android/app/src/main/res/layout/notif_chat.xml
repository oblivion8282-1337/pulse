<?xml version="1.0" encoding="utf-8"?>
<!-- Eigenes Chat-Notification-Layout (WhatsApp-Stil, Pulse-Optik): „PULSE“
     klein oben, Kontaktbild + Absender, Nachricht DARUNTER, Zeitstempel
     rechts, Lese-Aktion als Knopf. Gebaut in HinweisePlugin.nachricht(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FF1B1C20"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/notif_kopf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PULSE"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#FF8FB3FF"
        android:letterSpacing="0.2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <ImageView
            android:id="@+id/notif_avatar"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/notif_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/notif_zeit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FF9AA0A6" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="56dp"
        android:textSize="14sp"
        android:textColor="#FFE8EAED" />

    <TextView
        android:id="@+id/notif_gelesen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:text="ALS GELESEN MARKIEREN"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:background="#FF2563EB" />
</LinearLayout>
