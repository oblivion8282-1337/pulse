<?xml version="1.0" encoding="utf-8"?>
<!-- Nur DEBUG-Builds: gibt Cleartext für die Dev-Loopback-Hosts frei
     (server.url http://localhost:5173 / 10.0.2.2, s. UEBERGABE-MOBILE.md §6).
     Das main-Manifest setzt usesCleartextTraffic=false (Bughunt 45, E2EE-
     Client) — eine networkSecurityConfig hat gegen das Flag Vorrang, das
     Release-Build ohne dieses Overlay bleibt also hart https-only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/dev_cleartext_loopback" />
</manifest>
