# syntax=docker/dockerfile:1
#
# Parametrized image for the five FastAPI workspace services
# (auth · chat-gateway · voice-signaling · media-svc · mediamtx-auth-hook).
#
# Build from the repo root, e.g.:
#   docker build -f Dockerfile.service \
#     --build-arg SVC_DIR=auth --build-arg SVC_PKG=dcc_auth -t pulse-auth .
#   docker build -f Dockerfile.service \
#     --build-arg SVC_DIR=chat-gateway --build-arg SVC_PKG=dcc_chat_gateway -t pulse-chat-gateway .
#
# SVC_DIR = directory under services/ (also the package name with `dcc-` prefix → dcc-${SVC_DIR})
# SVC_PKG = importable Python module under services/${SVC_DIR}/src/
#
# All services listen on :8000 inside the container; the prod compose maps host
# ports where a host-network peer (MediaMTX/LiveKit) needs to reach one.

ARG PYTHON_VERSION=3.13

# ── builder ──────────────────────────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.11.11 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /app
ARG SVC_DIR

# 1) workspace metadata only → dependency layer is cached across source changes
COPY pyproject.toml uv.lock ./
COPY shared/pyproject.toml shared/pyproject.toml
COPY services/auth/pyproject.toml services/auth/pyproject.toml
COPY services/chat-gateway/pyproject.toml services/chat-gateway/pyproject.toml
COPY services/voice-signaling/pyproject.toml services/voice-signaling/pyproject.toml
COPY services/media-svc/pyproject.toml services/media-svc/pyproject.toml
COPY services/mediamtx-auth-hook/pyproject.toml services/mediamtx-auth-hook/pyproject.toml
COPY streaming/pyproject.toml streaming/pyproject.toml
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-workspace --package "dcc-${SVC_DIR}"

# 2) project source → install dcc-${SVC_DIR} + dcc-shared (editable)
COPY shared/ shared/
COPY services/${SVC_DIR}/ services/${SVC_DIR}/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package "dcc-${SVC_DIR}"

# 3) Top-Level plugins/ (hello + tamagotchi) → /app/plugins, damit der
# chat-gateway-Loader sie per discover_plugins_dir()-Walk-up findet (sucht
# einen `plugins/`-Sibling, hier /app/plugins). Ohne das läuft die
# Backend-Plugin-Discovery in Prod leer → alle Plugins erscheinen als
# "verwaist" und werden nie geladen. Nur chat-gateway nutzt es; für die
# anderen Services ist der Ordner harmloser Ballast (wenige KB).
COPY plugins/ plugins/

# ── runtime ──────────────────────────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-slim AS runtime
ARG SVC_DIR
ARG SVC_PKG
RUN useradd --create-home --uid 10001 app
WORKDIR /app/services/${SVC_DIR}
COPY --from=builder --chown=app:app /app /app
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    SVC_PKG=${SVC_PKG}
USER app
# Create the avatar upload dir owned by `app` (uploads/ is .dockerignore'd, so
# it isn't in the COPY). Matters when a fresh empty `pulse_avatars` named volume
# is mounted here: Docker seeds it from the image → it inherits `app` ownership,
# so the service (uid 10001) can actually write avatars into it. Harmless for the
# non-auth services (just an empty dir).
RUN mkdir -p uploads/avatars uploads/guild-icons
EXPOSE 8000
# shell form so ${SVC_PKG} expands; exec so uvicorn is PID 1 (clean signals).
# `--ws-max-size` caps inbound WS frames at 64 KiB — the chat-gateway exposes
# the only WS endpoint and enforces its own 16 KiB application cap
# (`_MAX_WS_FRAME_BYTES`); uvicorn's default of 16 MiB would buffer a huge
# frame before the app check runs (memory-DoS). No-op for the HTTP-only
# services (auth/voice/media/hook ignore it).
CMD exec uvicorn "${SVC_PKG}.app:app" --host 0.0.0.0 --port 8000 --ws-max-size 65536
