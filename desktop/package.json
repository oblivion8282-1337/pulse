{
  "name": "@dcc/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Pulse desktop wrapper (Electron)",
  "main": "electron/dist/main.cjs",
  "desktopName": "com.unicutmedia.Pulse.desktop",
  "scripts": {
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outdir=electron/dist --out-extension:.js=.cjs",
    "dev": "pnpm run build:electron && PULSE_DEV_URL=${PULSE_DEV_URL:-http://localhost:5173} electron .",
    "prod": "pnpm run build:electron && electron .",
    "start": "electron .",
    "dist:win": "pnpm run build:electron && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "electron": "42.0.1",
    "electron-builder": "26.0.12",
    "esbuild": "0.28.0"
  }
}
