{
    # Global Options
    email {$PULSE_ADMIN_EMAIL}
    # Auto-TLS via Let's Encrypt (Default, PULSE_TLS_MODE=auto).
    # PULSE_TLS_MODE=provided → eigenes Cert unter /data/certs/{cert.pem,key.pem}.
    # 07-init-caddy.sh patcht den Site-Block entsprechend beim Container-Start.
}

{$PULSE_HOSTNAME} {
    # ------------------------------------------------------------------ #
    # Security-Headers (Plan §Phase 6, identisch Cloud-Production)       #
    # ------------------------------------------------------------------ #
    # Die CSP spiegelt die Meta-CSP in web/src/app.html (ohne die Dev-
    # localhost-Einträge) — als Header-Policy gilt die SCHNITTMENGE beider
    # Policies. Eine engere Header-CSP (frühere Version: script-src 'self',
    # kein frame-src) blockt sonst die YouTube/Twitch-Embeds der Watch-Party,
    # das Theme-FOUC-Inline-Script und das WASM des Noise-Filters.
    # Änderungen an der Meta-CSP hier nachziehen (und in web-nginx.conf).
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://www.youtube.com https://www.youtube-nocookie.com https://embed.twitch.tv; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.twitch.tv https://embed.twitch.tv; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' ws: wss: https: stun: turn:; font-src 'self' data:; media-src 'self' blob: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
        -Server
    }

    # ------------------------------------------------------------------ #
    # CORS: NICHT hier setzen. Die FastAPI-Services (auth/chat/media/voice)
    # haben jeweils CORSMiddleware (CORS_ALLOW_ORIGINS) und setzen
    # Access-Control-Allow-Origin/-Credentials + beantworten OPTIONS-Preflights
    # selbst — exakt wie in der Cloud (web-nginx.conf setzt ebenfalls kein CORS).
    # Würde Caddy die Header zusätzlich setzen, kämen sie DOPPELT
    # (zwei Access-Control-Allow-Origin) → der Browser verwirft die Antwort als
    # CORS-Fehler ("Failed to fetch") und "Server hinzufügen" / Cert-Login bricht.
    # MediaMTX (/whep) bringt sein eigenes CORS via mediamtx.yml mit.
    # ------------------------------------------------------------------ #

    # ------------------------------------------------------------------ #
    # Health (öffentlich, kein Auth) — für Monitoring/Uptime-Checks      #
    # ------------------------------------------------------------------ #
    # Erststart-Fortschritt (cont-init-Phasen + Zertifikat). Eigener Block,
    # weil `handle /health` in Caddy GENAU diesen Pfad trifft und nicht das
    # Unterverzeichnis — ohne diese Zeile fiele /health/setup auf die leere
    # SPA-Antwort ganz unten durch und der Installer bekäme HTML statt JSON.
    handle /health/setup {
        reverse_proxy 127.0.0.1:8002 {
            header_up X-Forwarded-For {remote_host}
        }
    }

    handle /health {
        reverse_proxy 127.0.0.1:8002 {
            # Overwrite any client-supplied X-Forwarded-For with the real peer.
            # Caddy is the edge here, so the per-IP rate limiters in auth-svc /
            # chat-gateway (cert-login, login) must key on {remote_host}, not on
            # a header the client could forge. Caddy APPENDS to an inbound XFF by
            # default → without this, `X-Forwarded-For: 1.2.3.4` from the client
            # would land first and let an attacker rotate buckets / spoof IPs.
            # Mirror of the Cloud Caddyfile.pulse.snippet.
            header_up X-Forwarded-For {remote_host}
        }
    }

    # ------------------------------------------------------------------ #
    # API-Routes                                                          #
    # ------------------------------------------------------------------ #

    # auth-svc (8001) — login, MFA, identity-cert, /.well-known/jwks.json
    handle_path /api/auth/* {
        reverse_proxy 127.0.0.1:8001 {
            header_up X-Forwarded-For {remote_host}
        }
    }
    # Public identity well-known endpoints, served by auth-svc at the ROOT path.
    # Exact paths (NOT /.well-known/*) so /.well-known/acme-challenge stays free
    # for Let's Encrypt in PULSE_TLS_MODE=auto. Without these the SPA-Fallback
    # (handle {} below) returns index.html → Clients/Cloud-Poller get HTML instead
    # of JSON (JSONDecodeError, silent CRL/JWKS failure, broken "Server hinzufügen").
    @wellknown_auth path /.well-known/jwks.json /.well-known/revoked-credentials /.well-known/pulse-version-policy.json /.well-known/pulse-suspended-instances
    handle @wellknown_auth {
        reverse_proxy 127.0.0.1:8001 {
            header_up X-Forwarded-For {remote_host}
        }
    }
    # pulse-server-info is the "Server hinzufügen" pre-check — served by
    # chat-gateway (8002), NOT auth-svc.
    handle /.well-known/pulse-server-info {
        reverse_proxy 127.0.0.1:8002 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
        }
    }
    # pulse-owner-check beantwortet der Erreichbarkeitsprüfung, ob dieser
    # Server den Fragenden als Betreiber kennt. Ohne diese Zeile greift der
    # SPA-Rückfall unten und liefert HTML — die Prüfung sähe dann einen
    # älteren Server statt einer fehlenden Route. Ebenfalls chat-gateway.
    handle /.well-known/pulse-owner-check {
        reverse_proxy 127.0.0.1:8002 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # chat-gateway (8002)
    handle_path /api/chat/* {
        reverse_proxy 127.0.0.1:8002 {
            header_up Host {host}
            # cert-login is rate-limited per client IP (client_ip.py) — see the
            # /health block above for why XFF must be the real peer here.
            header_up X-Forwarded-For {remote_host}
        }
    }

    # WebSocket — chat-gateway (8002)
    handle /ws {
        reverse_proxy 127.0.0.1:8002 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # voice-signaling (8003) — Webhook + interne Endpoints sind NICHT öffentlich
    # (Spiegel der Cloud-nginx `deny all`-Blocks): /webhook ist zwar LiveKit-
    # signaturgeprüft und /internal/* fail-closed, aber öffentlich erreichbar
    # wären sie ein Webhook-Flooding-/Defense-in-Depth-Gap. LiveKit ruft den
    # Webhook containerintern auf 127.0.0.1:8003 auf, nie über Caddy.
    @voice_restricted path /api/voice/webhook /api/voice/internal/*
    handle @voice_restricted {
        respond 403
    }
    handle_path /api/voice/* {
        reverse_proxy 127.0.0.1:8003 {
            header_up X-Forwarded-For {remote_host}
        }
    }

    # media-svc (8004): bewusst KEINE öffentliche Route. Der einzige legitime
    # Pfad läuft über chat-gateway (/api/chat/channels/{id}/stream-token bzw.
    # /whep), das Membership + VIEW_CHANNEL prüft und den Bearer weiterreicht.
    # Eine frühere direkte /api/media/*-Route exponierte GET /channels/{id}/whep
    # (damals ohne Auth) → Stream-URLs für Nicht-Mitglieder. Das Frontend
    # spricht /api/media nie direkt an.

    # ------------------------------------------------------------------ #
    # WHEP/WHIP für MediaMTX HQ-Streaming (8889)                         #
    # ------------------------------------------------------------------ #
    # handle_path strippt das /whep-Prefix (wie die Cloud-nginx mit
    # ``proxy_pass …:8889/``) — MediaMTX erwartet den Pfad ohne /whep.
    handle_path /whep/* {
        reverse_proxy 127.0.0.1:8889
    }

    # WHIP/WHEP-Session-Ressourcen: MediaMTX baut die Location-URL des POSTs
    # aus dem Pfad, den es selbst sieht — also OHNE /whep-Präfix. Das
    # DELETE/PATCH des Publishers auf die Session-URL kommt deshalb präfixlos
    # an und muss ebenfalls zu MediaMTX (sonst räumt die Session erst per
    # ICE-Timeout ab). Lokal verifiziert 2026-07-12 (ffmpeg-WHIP → Dispose ok).
    @mtxsession path_regexp ^/channel-[^/]+/(whip|whep)(/.*)?$
    handle @mtxsession {
        reverse_proxy 127.0.0.1:8889
    }

    # ------------------------------------------------------------------ #
    # LiveKit WebSocket (7880)                                            #
    # ------------------------------------------------------------------ #
    # handle_path (NICHT handle) strippt /livekit → LiveKit sieht /rtc/v1.
    # Die Cloud-nginx macht dasselbe via ``proxy_pass …:7880/`` (trailing slash).
    # Ohne Strip bekäme LiveKit /livekit/rtc/v1 → Voice-Connect schlägt fehl (F15).
    handle_path /livekit/* {
        reverse_proxy 127.0.0.1:7880
    }

    # ------------------------------------------------------------------ #
    # MinIO (S3-API) — Message-Attachments (Path-Style, Bucket = Prefix) #
    # ------------------------------------------------------------------ #
    # Presigned URLs, die der Browser PUTet/GETtet, zeigen auf
    # /<bucket>/<key> = /pulse-attachments/... . MinIO kann NICHT unter einem
    # Sub-Pfad laufen (MINIO_SERVER_URL mit /s3 verwirft das Prefix → kaputte
    # Signaturen, in der Cloud empirisch verifiziert), darum leiten wir das
    # Bucket-Prefix unverändert weiter — exakt wie die Cloud-nginx
    # (location /pulse-attachments/). NUR das Bucket-Prefix ist öffentlich;
    # MinIOs Admin-/Console-API bleibt unerreichbar (keine Caddy-Route dahin).
    # `handle` (NICHT handle_path) — der Bucket-Name ist Teil des S3-Pfads.
    # SigV4 signiert den Host-Header → Host auf den Public-Host zwingen, damit
    # er zur vom chat-gateway signierten URL passt.
    handle /pulse-attachments/* {
        reverse_proxy 127.0.0.1:9000 {
            header_up Host {host}
            # MinIO doesn't rate-limit on XFF, but keep every edge proxy block
            # consistent: never forward a client-supplied X-Forwarded-For.
            header_up X-Forwarded-For {remote_host}
        }
    }

    # ------------------------------------------------------------------ #
    # Internal Endpoints — JWT-validiert, nicht öffentlich dokumentiert  #
    # ------------------------------------------------------------------ #

    # Cloud-getriggerter Update-Webhook (JWT, rate-limited in chat-gateway)
    handle /internal/trigger-update {
        reverse_proxy 127.0.0.1:8002 {
            header_up X-Forwarded-For {remote_host}
        }
    }

    # Cloud-Health-Probe nach Update (JWT, purpose=health-probe)
    handle /internal/health-probe {
        reverse_proxy 127.0.0.1:8002 {
            header_up X-Forwarded-For {remote_host}
        }
    }

    # ------------------------------------------------------------------ #
    # Kein Web-UI auf einem Self-Host. Identität + Client leben in der     #
    # Cloud (howispulse.com); Nutzer verbinden sich von dort per           #
    # cert-login zu den /api-, /ws-, /whep- und /livekit-Routen oben.      #
    # Ein Browser, der die Server-Domain direkt aufruft, bekommt bewusst   #
    # eine leere Seite — Login/Registrierung sind hier nicht möglich.      #
    # ------------------------------------------------------------------ #
    handle {
        header Content-Type "text/html; charset=utf-8"
        respond "<!doctype html><html><head></head><body></body></html>" 200
    }
}
