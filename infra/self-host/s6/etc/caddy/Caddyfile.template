{
    # Global Options
    email {$PULSE_ADMIN_EMAIL}
    # Auto-TLS via Let's Encrypt (Default, PULSE_TLS_MODE=auto).
    # PULSE_TLS_MODE=provided → eigenes Cert unter /data/certs/{cert.pem,key.pem}.
    # 07-init-caddy.sh patcht den Site-Block entsprechend beim Container-Start.
}

{$PULSE_HOSTNAME} {
    # ------------------------------------------------------------------ #
    # Security-Headers (Plan §Phase 6, identisch Cloud-Production)       #
    # ------------------------------------------------------------------ #
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; connect-src 'self' wss://*; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'"
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
        -Server
    }

    # ------------------------------------------------------------------ #
    # CORS: NICHT hier setzen. Die FastAPI-Services (auth/chat/media/voice)
    # haben jeweils CORSMiddleware (CORS_ALLOW_ORIGINS) und setzen
    # Access-Control-Allow-Origin/-Credentials + beantworten OPTIONS-Preflights
    # selbst — exakt wie in der Cloud (web-nginx.conf setzt ebenfalls kein CORS).
    # Würde Caddy die Header zusätzlich setzen, kämen sie DOPPELT
    # (zwei Access-Control-Allow-Origin) → der Browser verwirft die Antwort als
    # CORS-Fehler ("Failed to fetch") und "Server hinzufügen" / Cert-Login bricht.
    # MediaMTX (/whep) bringt sein eigenes CORS via mediamtx.yml mit.
    # ------------------------------------------------------------------ #

    # ------------------------------------------------------------------ #
    # Health (öffentlich, kein Auth) — für Monitoring/Uptime-Checks      #
    # ------------------------------------------------------------------ #
    handle /health {
        reverse_proxy 127.0.0.1:8002
    }

    # ------------------------------------------------------------------ #
    # API-Routes                                                          #
    # ------------------------------------------------------------------ #

    # auth-svc (8001) — login, MFA, identity-cert, /.well-known/jwks.json
    handle_path /api/auth/* {
        reverse_proxy 127.0.0.1:8001
    }
    # Public identity well-known endpoints, served by auth-svc at the ROOT path.
    # Exact paths (NOT /.well-known/*) so /.well-known/acme-challenge stays free
    # for Let's Encrypt in PULSE_TLS_MODE=auto. Without these the SPA-Fallback
    # (handle {} below) returns index.html → Clients/Cloud-Poller get HTML instead
    # of JSON (JSONDecodeError, silent CRL/JWKS failure, broken "Server hinzufügen").
    @wellknown_auth path /.well-known/jwks.json /.well-known/revoked-credentials /.well-known/pulse-version-policy.json /.well-known/pulse-suspended-instances
    handle @wellknown_auth {
        reverse_proxy 127.0.0.1:8001
    }
    # pulse-server-info is the "Server hinzufügen" pre-check — served by
    # chat-gateway (8002), NOT auth-svc.
    handle /.well-known/pulse-server-info {
        reverse_proxy 127.0.0.1:8002 {
            header_up Host {host}
        }
    }

    # chat-gateway (8002)
    handle_path /api/chat/* {
        reverse_proxy 127.0.0.1:8002 {
            header_up Host {host}
        }
    }

    # WebSocket — chat-gateway (8002)
    handle /ws {
        reverse_proxy 127.0.0.1:8002 {
            header_up Host {host}
        }
    }

    # voice-signaling (8003)
    handle_path /api/voice/* {
        reverse_proxy 127.0.0.1:8003
    }

    # media-svc (8004)
    handle_path /api/media/* {
        reverse_proxy 127.0.0.1:8004
    }

    # ------------------------------------------------------------------ #
    # WHEP für MediaMTX HQ-Streaming (8889)                              #
    # ------------------------------------------------------------------ #
    # handle_path strippt das /whep-Prefix (wie die Cloud-nginx mit
    # ``proxy_pass …:8889/``) — MediaMTX erwartet den Pfad ohne /whep.
    handle_path /whep/* {
        reverse_proxy 127.0.0.1:8889
    }

    # ------------------------------------------------------------------ #
    # LiveKit WebSocket (7880)                                            #
    # ------------------------------------------------------------------ #
    # handle_path (NICHT handle) strippt /livekit → LiveKit sieht /rtc/v1.
    # Die Cloud-nginx macht dasselbe via ``proxy_pass …:7880/`` (trailing slash).
    # Ohne Strip bekäme LiveKit /livekit/rtc/v1 → Voice-Connect schlägt fehl (F15).
    handle_path /livekit/* {
        reverse_proxy 127.0.0.1:7880
    }

    # ------------------------------------------------------------------ #
    # MinIO (S3-API) — Message-Attachments (Path-Style, Bucket = Prefix) #
    # ------------------------------------------------------------------ #
    # Presigned URLs, die der Browser PUTet/GETtet, zeigen auf
    # /<bucket>/<key> = /pulse-attachments/... . MinIO kann NICHT unter einem
    # Sub-Pfad laufen (MINIO_SERVER_URL mit /s3 verwirft das Prefix → kaputte
    # Signaturen, in der Cloud empirisch verifiziert), darum leiten wir das
    # Bucket-Prefix unverändert weiter — exakt wie die Cloud-nginx
    # (location /pulse-attachments/). NUR das Bucket-Prefix ist öffentlich;
    # MinIOs Admin-/Console-API bleibt unerreichbar (keine Caddy-Route dahin).
    # `handle` (NICHT handle_path) — der Bucket-Name ist Teil des S3-Pfads.
    # SigV4 signiert den Host-Header → Host auf den Public-Host zwingen, damit
    # er zur vom chat-gateway signierten URL passt.
    handle /pulse-attachments/* {
        reverse_proxy 127.0.0.1:9000 {
            header_up Host {host}
        }
    }

    # ------------------------------------------------------------------ #
    # Internal Endpoints — JWT-validiert, nicht öffentlich dokumentiert  #
    # ------------------------------------------------------------------ #

    # Cloud-getriggerter Update-Webhook (JWT, rate-limited in chat-gateway)
    handle /internal/trigger-update {
        reverse_proxy 127.0.0.1:8002
    }

    # Cloud-Health-Probe nach Update (JWT, purpose=health-probe)
    handle /internal/health-probe {
        reverse_proxy 127.0.0.1:8002
    }

    # ------------------------------------------------------------------ #
    # SPA Fallback — alles andere → Web-Static                           #
    # ------------------------------------------------------------------ #
    handle {
        root * /var/www/pulse
        try_files {path} /index.html
        file_server
        encode gzip
    }
}
