#!/bin/sh
# MediaMTX — HQ stream relay (RTMPS→WHEP). authHTTP → mediamtx-auth-hook
# at 127.0.0.1:8005. Config rendered by cont-init.
#
# `PULSE_KEYFRAME_INTERVAL=0` — wie die Cloud (infra/prod/docker-compose.yml)
# den fest verdrahteten 2-s-Vollbild-Takt des Forks abschalten. Der Fork
# (PULSE_MEDIAMTX_TAG im Dockerfile, seit 2026-09-07) kennt den Schalter;
# ohne ihn fordert MediaMTX alle 2 s ein Vollbild vom Sender an — gemessen
# 2026-09-25 als Mit-Ursache des wachsenden Zuschauer-Lags an einem
# Self-Host (s. Kommentar zu `hls` in 08-init-mediamtx.sh).
exec 2>&1
PULSE_KEYFRAME_INTERVAL=0 exec /usr/sbin/gosu pulse /usr/local/bin/mediamtx /etc/mediamtx/mediamtx.yml
