#!/bin/sh
# Redis — embedded pub/sub + cache. Local-only bind. AOF persistence so
# a crash doesn't drop e.g. voice presence sets mid-session.
exec 2>&1
exec /usr/sbin/gosu pulse /usr/bin/redis-server \
  --bind 127.0.0.1 \
  --port 6379 \
  --dir /data/redis \
  --appendonly yes \
  --save 60 1000 \
  --maxmemory-policy noeviction \
  --loglevel notice
