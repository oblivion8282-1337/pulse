# LiveKit-Config für Pulse Self-Host (gerendert von 05-init-livekit.sh:
# @@LIVEKIT_KEY@@ / @@LIVEKIT_SECRET@@ werden beim Container-Start ersetzt).
#
# Ohne dieses Template fällt 05-init-livekit auf eine Minimal-Config zurück, die
# KEIN use_external_ip kennt → LiveKit nimmt die interne Docker-IP (10.x) als
# ICE-Kandidat → externe Clients bekommen keine Media-Verbindung (F13).
port: 7880
bind_addresses:
  - 0.0.0.0
rtc:
  tcp_port: 7881
  port_range_start: 7882
  port_range_end: 7892
  # LiveKit ermittelt seine öffentliche IP per STUN und gibt SIE als ICE-Kandidat
  # aus (nicht die interne Docker-Bridge-IP). Das ist der Standardweg hinter
  # NAT/Docker und macht ein manuelles PULSE_PUBLIC_IP für den direkten Media-
  # Pfad überflüssig.
  use_external_ip: true
  # Hinter hairpin-losem NAT (Fritz!Box + rootless-podman/pasta) scheitert
  # LiveKits Selbst-Validierung der STUN-IP ("could not validate external IP",
  # der Anruf von innen auf die eigene Außenadresse kommt nie an) — OHNE diesen
  # Schalter wird die korrekte öffentliche IPv4 dann VERWORFEN und Gäste sehen
  # nur LAN-/IPv6-Kandidaten → Voice/Streaming für Externe tot. Ab v1.13.1
  # (mediatransportutil PR #88); am echten App-Host verifiziert 2026-07-13.
  skip_external_ip_validation: true
  # Öffentliche IPv4 ZUSÄTZLICH zum LAN-Host-Kandidaten ankündigen (pion
  # Append- statt Replace-Modus) — sonst verlöre der Owner im selben LAN
  # seinen 192.168er-Weg und hinge am kaputten Hairpin.
  advertise_internal_ip: true
  # IPv6-Kandidaten unterdrücken: Fritz!Box blockt eingehendes IPv6 → Gäste
  # laufen auf v6-Kandidaten nur in Timeouts (bekannter Dauer-Fallstrick,
  # gleiche Klasse wie der frühere WHEP-IPv6-Leak).
  ips:
    excludes:
      - "::/0"
keys:
  @@LIVEKIT_KEY@@: "@@LIVEKIT_SECRET@@"
webhook:
  api_key: @@LIVEKIT_KEY@@
  urls:
    - http://127.0.0.1:8003/webhook
log_level: info
