# Pulse Self-Host — Umgebungsvariablen
# Kopiere diese Datei nach .env und trage deine Werte ein.
# Pflicht-Vars sind mit [PFLICHT] markiert — ohne sie startet der Container nicht.
# Alle anderen Vars haben sichere Defaults.

# ==========================================================================
# PFLICHT-Vars (4 Stück — alles andere generiert sich selbst beim First-Start)
# ==========================================================================

# [PFLICHT] Dein öffentlicher Hostname — muss DNS-A-Record auf diese IP haben.
# Caddy nutzt diesen Namen für Let's Encrypt + als Caddy-Site-Block-Header.
# Beispiel: chat.firma.de
PULSE_HOSTNAME=chat.firma.de

# [PFLICHT] Client-ID aus dem Cloud-Approval-Prozess.
# Bekommst du auf howispulse.com unter "Meine Self-Host-Instances".
PULSE_CLOUD_CLIENT_ID=sh_live_xxxxxxxxxxxxxxxxxxxx

# [PFLICHT] Client-Secret aus dem Cloud-Approval-Prozess (einmalig sichtbar!).
# Bewahr diesen Wert sicher auf — er kann nicht erneut angezeigt werden.
PULSE_CLOUD_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [PFLICHT] Admin-E-Mail-Adresse.
# Wird für Let's Encrypt ACME-Anmeldung verwendet (Cert-Ablauf-Warnungen).
# Auch für Health-Probe-Notifications (DE 10c).
PULSE_ADMIN_EMAIL=admin@firma.de

# ==========================================================================
# TLS
# ==========================================================================

# TLS-Modus.
# auto     (Default) — Caddy holt Let's Encrypt-Cert automatisch.
#          Voraussetzung: Port 80 + 443 erreichbar + DNS korrekt gesetzt.
# provided — Eigenes Cert aus /data/certs/cert.pem + /data/certs/key.pem.
#            Für Hoster ohne Public-Reach (Tailscale Funnel, Cloudflare Tunnel,
#            internes Netz mit eigenem CA).
PULSE_TLS_MODE=auto

# ==========================================================================
# Voice-NAT / TURN
# ==========================================================================

# coturn deaktivieren (nur wenn du einen eigenen TURN-Server betreibst).
# Default: false (coturn läuft im Container für NAT-Traversal).
# PULSE_TURN_DISABLED=false

# ==========================================================================
# Datenhaltung
# ==========================================================================

# Pfad des persistenten Data-Volumes im Container.
# Nur ändern wenn du das Volume explizit woanders mountest.
# Default: /data
# PULSE_DATA_PATH=/data

# ==========================================================================
# Logging
# ==========================================================================

# Log-Level für alle Sub-Services.
# Werte: debug | info | warning | error
# Default: info
# PULSE_LOG_LEVEL=info

# ==========================================================================
# Backup
# ==========================================================================

# Anzahl Pre-Update-Backups (pg_dump vor jedem Container-Neustart via Watchtower).
# Default: 3
# PULSE_BACKUP_RETENTION_PRE=3

# Anzahl wöchentlicher Snapshots (sonntags, 02:00 UTC).
# Default: 4
# PULSE_BACKUP_RETENTION_WEEKLY=4

# Backup komplett deaktivieren — nur für externe Backup-Lösungen empfohlen.
# WARNUNG: Kein Backup = Datenverlust bei Disk-Failure. Nicht empfohlen.
# PULSE_BACKUP_DISABLED=false

# ==========================================================================
# Automatisch gesetzt im Single-Container (nicht überschreiben)
# ==========================================================================

# PULSE_CLOUD_ORIGIN=https://howispulse.com
# PULSE_INSTANCE_MODE=self-host
