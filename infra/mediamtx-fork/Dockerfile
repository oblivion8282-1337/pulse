# Pulse-forked MediaMTX image.
#
# Pulls the upstream v1.19.1 source, applies the patches/ in alphabetical
# order, and statically builds a stripped binary. The result is published
# as ghcr.io/oblivion8282-1337/pulse-mediamtx:<tag> and used in place of
# `bluenviron/mediamtx:1.19.1` in both the dev (streaming/server/) and
# prod (infra/prod/) compose files.
#
# Bumped 1.17.1 → 1.19.1 (2026-06-16): MediaMTX 1.17.1 took ~7-8s to establish
# an incoming VideoToolbox-H264 RTMP track (the macOS HQ-streaming sidecar),
# which over TLS+network exceeded the 10s readTimeout → the publish was dropped.
# 1.19.1 establishes it instantly. The AV1 temporal-delimiter patch below still
# applies cleanly and is still needed (no upstream AV1 fix in 1.18/1.19).
#
# Why we maintain this fork — five patches, two groups:
#
#   patches/         go against the MediaMTX source, applied right after clone
#     0001  AMD-VAAPI-encoded AV1 freezes in WHEP after a few seconds because
#           the bitstream lacks OBU_TEMPORAL_DELIMITER OBUs (spec-permitted,
#           but libwebrtc relies on them for frame boundaries). Injects one in
#           the RTMP→stream path.
#     0002  A viewer's key frame request (PLI/FIR) died in outbound_track.go,
#           so after a packet loss the picture froze permanently while data
#           kept arriving. Builds the return path to the publisher, and makes
#           the hardwired 2s key frame ticker configurable
#           (PULSE_KEYFRAME_INTERVAL) — that ticker defeats intra refresh.
#     0003  FlexFEC on the WHEP sending side (PULSE_FLEXFEC), because parity
#           generated by our sender cannot survive the hop: MediaMTX rewrites
#           SSRC and sequence numbers.
#     0004  Makes that parity adaptive (PULSE_FLEXFEC_ADAPTIV).
#
#   patches-vendor/  go against VENDORED third-party code, applied after
#                    `go mod vendor` (see the step below)
#     0005  pion's FlexFEC encoder buffered NACK retransmissions, which broke
#           the sequence continuity `EncodeFec` requires — under 5 % loss the
#           parity output collapsed to a fifth of nominal.
#
# Every PULSE_* variable above is off by default: unset, the server behaves
# exactly like upstream. See each patch header for measurements and the
# conditions for dropping it.
#
# Bumping MediaMTX: change `MEDIAMTX_VERSION` below + `patch -p1 --dry-run`
# every patch against the new tag first — the vendored one only after
# `go mod vendor`, and note that its target moves with the pion version.

ARG MEDIAMTX_VERSION=1.19.1
# Unser Patch-Stand, und er gehoert in den Tag.
#
# **Warum das noetig wurde:** bis 2026-08-04 baute der Workflow immer
# `<version>-pulse`, egal wie viele Patches darin steckten. Beim Sprung von
# EINEM auf FUENF Patches (Vollbild-Rueckweg, FlexFEC, adaptive Paritaet, der
# vendorierte pion-Patch) haette derselbe Tag auf voellig anderen Inhalt
# gezeigt — ohne dass man es ihm ansieht, und ohne Rueckweg ausser einem
# Rebuild. Genau davor warnt die README dieses Verzeichnisses.
#
# Jetzt steht der Stand im Tag: `1.19.1-pulse5`. Ein Rueckweg ist damit eine
# Zeile in `infra/prod/docker-compose.yml` statt eines Neubaus, und das alte
# `1.19.1-pulse` bleibt in der Registry unangetastet.
#
# **Hochzaehlen, sobald sich der Patch-Satz aendert** — nicht bei einem
# MediaMTX-Bump, der bewegt `MEDIAMTX_VERSION`.
ARG PULSE_REVISION=5
ARG GO_VERSION=1.26

# ── Stage 1: build the patched binary ──────────────────────────────────────
FROM golang:${GO_VERSION}-alpine AS build
ARG MEDIAMTX_VERSION

WORKDIR /src
RUN apk add --no-cache git patch

# Shallow clone the exact upstream tag. `--depth=1` keeps the build
# context small; we don't need history because the patches are line-
# anchored against this single revision.
RUN git clone --depth=1 -b v${MEDIAMTX_VERSION} \
      https://github.com/bluenviron/mediamtx.git .

# Apply every patch under patches/ in alphabetical order. Fail loudly if
# any of them doesn't apply cleanly — we'd rather the build break here
# than ship an unpatched image to prod.
COPY patches/*.patch /tmp/pulse-patches/
RUN set -e; \
    for p in /tmp/pulse-patches/*.patch; do \
      echo "→ applying $(basename "$p")"; \
      patch -p1 < "$p"; \
    done

# The Bildmarke fixture (patch 0006) is NOT carried inside the patch — it is a
# copy of `streaming/bildmarke-formen.json`, produced by the SENDER, and a copy
# living inside a diff would go stale in silence. It rides along as a plain
# file instead, and a test in the Pulse repo
# (`streaming/pulse-player/tests/zwillinge.rs`) holds the two identical.
COPY bildmarke-formen.json internal/protocols/webrtc/testdata/bildmarke-formen.json

# Two generators have to run before `go build`:
#   * internal/servers/hls/hlsjsdownloader  — fetches hls.min.js (embedded into the binary)
#   * internal/core/versiongetter           — writes internal/core/VERSION (embedded too)
# Both are referenced via `//go:embed` directives, so a missing file is
# a hard compile error. The third generator (rpicamera/mtxrpicamdownloader)
# pulls ARM-only binaries we don't need — skip it explicitly by listing
# the two we want instead of running `go generate ./...`.
RUN go generate -mod=mod ./internal/servers/hls/... \
                         ./internal/core/...

# Patches against VENDORED third-party code (pion's FlexFEC interceptor) can
# only be applied once the dependency tree is on disk — `go mod vendor` would
# otherwise overwrite them again. So: vendor first, patch second. `go build`
# picks the vendor tree up automatically from here on, which also pins the
# build offline; that is why `go generate` above needs an explicit `-mod=mod`
# (it runs before the vendor directory exists).
RUN go mod vendor
COPY patches-vendor/*.patch /tmp/pulse-vendor-patches/
RUN set -e; \
    for p in /tmp/pulse-vendor-patches/*.patch; do \
      echo "→ applying (vendored) $(basename "$p")"; \
      patch -p1 < "$p"; \
    done

# Standard MediaMTX build settings — matches what their `binaries.mk`
# uses for the official linux/amd64 binary, minus the cross-compile bits.
RUN CGO_ENABLED=0 \
    go build \
      -tags=osusergo,netgo \
      -ldflags="-s -w" \
      -trimpath \
      -o /out/mediamtx \
      .

# ── Stage 2: minimal runtime ──────────────────────────────────────────────
# Match upstream's `docker/standard.Dockerfile` shape — `FROM scratch`
# with just the binary and the CA bundle so that `authHTTPAddress=https://…`
# works without surprises.
FROM scratch

COPY --from=build /out/mediamtx /mediamtx
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

ENTRYPOINT ["/mediamtx"]
