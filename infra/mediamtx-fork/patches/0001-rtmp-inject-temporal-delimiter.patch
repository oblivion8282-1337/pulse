# Prepend an OBU_TEMPORAL_DELIMITER to every AV1 temporal unit coming in
# over RTMP if one isn't already there. AMD VAAPI's av1_vaapi encoder
# does not emit Temporal Delimiter OBUs (spec-permitted in low-overhead
# bitstream form), while NVENC does — and Chromium's libwebrtc-side AV1
# RTP receiver relies on them for frame-boundary detection, so AV1 over
# WHEP silently freezes after a few seconds for AMD publishers while
# NVIDIA works.
#
# OBU layout (AV1 spec 5.3.2):
#   obu_forbidden_bit          : 1 bit  = 0
#   obu_type                   : 4 bits = 2 (OBU_TEMPORAL_DELIMITER)
#   obu_extension_flag         : 1 bit  = 0
#   obu_has_size_field         : 1 bit  = 0 (mediamtx stores OBUs with this masked off)
#   obu_reserved_1bit          : 1 bit  = 0
# → header byte = 0b00010000 = 0x10. Payload is empty.
#
# `av1.Bitstream.Unmarshal` (in mediacommon) clears the has_size bit when
# producing its slice form, so the stored OBU is the single byte 0x10.
# `av1.Bitstream.Marshal` re-injects has_size + LEB128(0) on the way out,
# yielding the standard 2-byte 0x12 0x00 on the wire.
#
# Test:  ffmpeg -bsf:v av1_metadata=td=insert reproduces the same effect
# on a captured FLV (verified: AMD-VAAPI bitstream goes from 0 TempDelim
# OBUs to one per frame, dav1d still decodes cleanly).
#
# Remove once one of:
#   (a) MediaMTX upstream applies a similar workaround or the AV1-RTP
#       receiver/encoder relaxes its TempDelim requirement.
#   (b) AMD's Mesa VAAPI AV1 encoder starts emitting TempDelim by default.

diff --git a/internal/protocols/rtmp/to_stream.go b/internal/protocols/rtmp/to_stream.go
--- a/internal/protocols/rtmp/to_stream.go
+++ b/internal/protocols/rtmp/to_stream.go
@@ -50,6 +50,12 @@ func ToStream(
 			medias = append(medias, medi)

 			r.OnDataAV1(track, func(pts time.Duration, tu [][]byte) {
+				// Inject an OBU_TEMPORAL_DELIMITER if missing (Pulse fork —
+				// see infra/mediamtx-fork/patches/ for the rationale).
+				if len(tu) == 0 || len(tu[0]) == 0 || (tu[0][0]>>3)&0xF != 2 {
+					tu = append([][]byte{{0x10}}, tu...)
+				}
+
 				(*subStream).WriteUnit(medi, forma, &unit.Unit{
 					PTS:     durationToTimestamp(pts, forma.ClockRate()),
 					Payload: unit.PayloadAV1(tu),
