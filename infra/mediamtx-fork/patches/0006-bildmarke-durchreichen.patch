+
+// bildmarkeUebertragen haengt die Marke des eingehenden Bildes an die neu
+// geschnittenen Pakete.
+//
+// `quelle` sind die Pakete, wie sie hereinkamen; `neu` die, die hinausgehen.
+// Uebernommen werden Bildnummer und Schablone, neu gesetzt werden nur
+// Bildanfang und Bildende — s. `bildmarke.go`.
+//
+// Verwirft MediaMTX ein beschaedigtes Bild, wird diese Funktion dafuer gar
+// nicht erst gerufen: dessen Nummer geht nie hinaus, und genau daran erkennt
+// der Zuschauer die Luecke.
+func (t *OutboundTrack) bildmarkeUebertragen(neu []*rtp.Packet, quelle []*rtp.Packet) {
+	if t.bildmarkeExtID == 0 || len(neu) == 0 {
+		return
+	}
+	marke := bildmarkeLesen(quelle)
+	if marke == nil {
+		return
+	}
+	for i, pkt := range neu {
+		bildmarkeSetzen(pkt, marke, t.bildmarkeExtID, i == 0, i == len(neu)-1)
+	}
 }
 
