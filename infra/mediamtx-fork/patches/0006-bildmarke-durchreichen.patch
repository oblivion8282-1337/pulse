 func (t *InboundTrack) initialize() {
 	t.OnPacketRTP = func(*rtp.Packet) {}
 	t.twccExtID = inboundTrackTWCCExtensionID(t.receiver.GetParameters())
+	t.bildmarkeExtID = bildmarkeExtensionID(t.receiver.GetParameters())
+}
+
+// normalisiereBildmarke schreibt die Marke auf die feste interne Nummer um.
+//
+// Eingang und Ausgang handeln die Erweiterung getrennt aus und bekommen dabei
+// verschiedene Nummern; `from_stream.go` sieht aber nur die Pakete, nicht die
+// Aushandlung des Eingangs. Volle Begruendung in `bildmarke.go`.
+func (t *InboundTrack) normalisiereBildmarke(pkt *rtp.Packet) {
+	if t.bildmarkeExtID == 0 || t.bildmarkeExtID == bildmarkeInterneID {
+		return
+	}
+	roh := pkt.GetExtension(t.bildmarkeExtID)
+	if len(roh) < bildmarkeLaengeMin {
+		return
+	}
+	pkt.SetExtension(bildmarkeInterneID, roh) //nolint:errcheck
+	pkt.DelExtension(t.bildmarkeExtID)        //nolint:errcheck
 }
 
 func (t *InboundTrack) stripTWCCExtension(pkt *rtp.Packet) {
@@ -462,6 +483,7 @@ func (t *InboundTrack) start() {
 				}
 
 				t.stripTWCCExtension(pkt)
+				t.normalisiereBildmarke(pkt)
 				t.OnPacketRTP(pkt)
 			}
 		}
