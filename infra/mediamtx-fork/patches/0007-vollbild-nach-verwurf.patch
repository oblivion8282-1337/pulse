@@ -108,6 +108,14 @@ func (ssf *subStreamFormat) writeUnitInner(u *unit.Unit) error {
 			var err error
 			u.Payload, err = ssf.rtpDecoder.decode(u.RTPPackets[0])
 			if err != nil {
+				// Pulse: this is the one place that knows a frame was lost
+				// for good (ErrMorePacketsNeeded never gets here, the
+				// decoder wrapper swallows it). Ask for a key frame BEFORE
+				// reporting, so the request is not tied to the error dumper's
+				// once-per-second summary.
+				if ssf.streamFormat.onFrameDiscarded != nil {
+					ssf.streamFormat.onFrameDiscarded()
+				}
 				return err
 			}
 		}
