diff --git a/internal/stream/stream_pulse_test.go b/internal/stream/stream_pulse_test.go
new file mode 100644
index 0000000..c729d32
--- /dev/null
+++ b/internal/stream/stream_pulse_test.go
@@ -0,0 +1,80 @@
+package stream
+
+import (
+	"sync/atomic"
+	"testing"
+
+	"github.com/bluenviron/gortsplib/v5/pkg/description"
+	"github.com/bluenviron/gortsplib/v5/pkg/format"
+	"github.com/bluenviron/mediamtx/internal/unit"
+	"github.com/pion/rtp"
+	"github.com/stretchr/testify/require"
+)
+
+// Pulse, patch 0007: a frame the RTP decoder discards must make the Stream
+// ask the publisher for a key frame — but only for video, and only when the
+// switch is set.
+//
+// The packets replay the real failure: an FU-A start fragment, then a
+// fragment whose sequence number skips one. gortsplib answers
+// "discarding frame since a RTP packet is missing", the same line the
+// production log showed on 2026-09-03 at 13:06:29 UTC.
+func pulseFeedBrokenFragments(t *testing.T, mediaType description.MediaType) uint32 {
+	t.Helper()
+
+	forma := &format.H264{PacketizationMode: 1}
+	desc := &description.Session{Medias: []*description.Media{{
+		Type:    mediaType,
+		Formats: []format.Format{forma},
+	}}}
+
+	strm := &Stream{
+		OrigDesc:          desc,
+		WriteQueueSize:    512,
+		RTPMaxPayloadSize: 1450,
+		Parent:            &nilLogger{},
+	}
+	require.NoError(t, strm.Initialize())
+	defer strm.Close()
+
+	var requests atomic.Uint32
+	strm.SetOnKeyFrameRequest(func() { requests.Add(1) })
+
+	subStream := &SubStream{Stream: strm, UseRTPPackets: true}
+	require.NoError(t, subStream.Initialize())
+
+	// FU-A start (S=1, type 5) — needs more packets, must NOT count.
+	subStream.WriteUnit(desc.Medias[0], forma, &unit.Unit{
+		RTPPackets: []*rtp.Packet{{
+			Header:  rtp.Header{Version: 2, PayloadType: 96, SequenceNumber: 10},
+			Payload: []byte{0x7c, 0x85, 1, 2, 3},
+		}},
+	})
+	require.Equal(t, uint32(0), requests.Load(), "a fragment that merely needs more packets is not a loss")
+
+	// FU-A middle with a sequence gap — the decoder gives the frame up.
+	subStream.WriteUnit(desc.Medias[0], forma, &unit.Unit{
+		RTPPackets: []*rtp.Packet{{
+			Header:  rtp.Header{Version: 2, PayloadType: 96, SequenceNumber: 12},
+			Payload: []byte{0x7c, 0x05, 4, 5, 6},
+		}},
+	})
+	require.Equal(t, uint64(1), strm.InboundFramesInError(), "the decoder must have discarded exactly one frame")
+
+	return requests.Load()
+}
+
+func TestPulseKeyFrameOnDiscardVideo(t *testing.T) {
+	t.Setenv("PULSE_KEYFRAME_ON_DISCARD", "1")
+	require.Equal(t, uint32(1), pulseFeedBrokenFragments(t, description.MediaTypeVideo))
+}
+
+func TestPulseKeyFrameOnDiscardOff(t *testing.T) {
+	t.Setenv("PULSE_KEYFRAME_ON_DISCARD", "")
+	require.Equal(t, uint32(0), pulseFeedBrokenFragments(t, description.MediaTypeVideo))
+}
+
+func TestPulseKeyFrameOnDiscardNotForAudio(t *testing.T) {
+	t.Setenv("PULSE_KEYFRAME_ON_DISCARD", "1")
+	require.Equal(t, uint32(0), pulseFeedBrokenFragments(t, description.MediaTypeAudio))
+}
