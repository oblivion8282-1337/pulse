# Pulse production environment — copy to `.env` (next to docker-compose.yml on
# the server, gitignored) and fill in the secrets. Deploy with:
#
#   cd ~/pulse/infra/prod && docker compose up -d
#
# This file is consumed two ways: docker compose interpolates ${...} in the
# compose YAML from it, AND it's loaded into the app containers (env_file: .env).
# env_file does NOT interpolate, so URLs that embed a password must have it
# written out in full (e.g. REDIS_URL) — keep it in sync with REDIS_PASSWORD.

# ── secrets (generate fresh; never commit the filled-in .env) ──
#   POSTGRES_PASSWORD : `openssl rand -hex 32`
#   REDIS_PASSWORD    : `openssl rand -hex 32`
#   LIVEKIT_API_SECRET: `openssl rand -hex 32`  (the LiveKit *secret*; the key
#                       *name* is fixed as "pulse-prod" in livekit.yaml + below)
#   MINIO_ROOT_PASSWORD: `openssl rand -hex 32`  (S3-API admin)
POSTGRES_PASSWORD=__CHANGE_ME__
REDIS_PASSWORD=__CHANGE_ME__
LIVEKIT_API_SECRET=__CHANGE_ME__
MINIO_ROOT_USER=pulse-admin
MINIO_ROOT_PASSWORD=__CHANGE_ME__

# ── Postgres (the pulse_postgres container; auth + chat-gateway connect here) ──
POSTGRES_USER=dcc
POSTGRES_DB=dcc
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis (the pulse_redis container; embed REDIS_PASSWORD here too) ──
REDIS_URL=redis://:__CHANGE_ME__@redis:6379/0

# ── JWT (RS256) — keypair lives at ./secrets/jwt_{private,public}.pem on the
#    server, mounted into the containers at /secrets ──
JWT_PRIVATE_KEY_FILE=/secrets/jwt_private.pem
JWT_PUBLIC_KEY_FILE=/secrets/jwt_public.pem
JWT_ISSUER=dcc-auth
JWT_AUDIENCE=dcc

# ── inter-service URLs (container names on pulse-net) ──
AUTH_JWKS_URL=http://auth:8000/.well-known/jwks.json
MEDIA_SVC_URL=http://media-svc:8000
# voice-signaling calls chat-gateway to verify channel membership before
# issuing a LiveKit token — DO NOT leave unset in production.
CHAT_GATEWAY_URL=http://chat-gateway:8000

# Auth-svc rate-limiter trusts X-Forwarded-For only when the immediate peer
# matches one of these IPs/CIDRs (CSV). In the production stack, auth sits
# behind pulse_web on pulse-net; set this to the pulse_web container's
# bridge IP (or the bridge subnet itself). The default is loopback-only
# which would lump *every* request into one bucket through pulse_web —
# fine for dev, bad for prod.
# To discover the bridge: `docker network inspect pulse-net` and pick the
# /24 from `IPAM.Config[0].Subnet`.
TRUSTED_PROXIES=127.0.0.1,::1,10.0.6.0/24

# ── CORS — the public origin only ──
CORS_ALLOW_ORIGINS=https://pulse.unicutmedia.com

# ── snowflake worker IDs (auth=1, chat=2, voice=3) ──
SNOWFLAKE_WORKER_ID_AUTH=1
SNOWFLAKE_WORKER_ID_CHAT=2
SNOWFLAKE_WORKER_ID_VOICE=3

# ── LiveKit (voice-signaling issues tokens with this pair; livekit.yaml gets
#    the secret via LIVEKIT_KEYS = "${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}") ──
LIVEKIT_API_KEY=pulse-prod
LIVEKIT_URL=wss://pulse.unicutmedia.com/livekit

# ── MediaMTX (media-svc builds push/playback URLs from these) ──
#   API is polled via the host (MediaMTX runs network_mode: host)
MEDIAMTX_API_URL=http://host.docker.internal:9997/v3/paths/list
#   ingest host = the public hostname the GSR sidecar pushes RTMPS/SRT to
MEDIAMTX_INGEST_HOST=pulse.unicutmedia.com
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_RTMPS_PORT=1936
MEDIAMTX_SRT_PORT=8890
#   public base for WHEP playback URLs → https://pulse.unicutmedia.com/whep/channel-<id>/whep
MEDIAMTX_PUBLIC_BASE=https://pulse.unicutmedia.com/whep

# ── MinIO (S3-compatible object store for message attachments) ──
#   S3_INTERNAL_ENDPOINT : how chat-gateway reaches MinIO for bucket-management
#                          ops (delete object, bucket creation). Container DNS.
#   S3_PUBLIC_ENDPOINT   : how presigned URLs are stamped — must match what the
#                          browser sees (nginx /s3/* → MinIO). MUST equal
#                          MINIO_SERVER_URL on the minio container or signatures
#                          won't verify.
#   S3_BUCKET            : pre-created by the minio-init compose service.
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://pulse.unicutmedia.com/s3
S3_REGION=us-east-1
S3_BUCKET=pulse-attachments
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
