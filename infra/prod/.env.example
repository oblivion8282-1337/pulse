# Pulse production environment — copy to `.env` (next to docker-compose.yml on
# the server, gitignored) and fill in the secrets. Deploy with:
#
#   cd ~/pulse/infra/prod && docker compose up -d
#
# This file is consumed two ways: docker compose interpolates ${...} in the
# compose YAML from it, AND it's loaded into the app containers (env_file: .env).
# env_file does NOT interpolate, so URLs that embed a password must have it
# written out in full (e.g. REDIS_URL) — keep it in sync with REDIS_PASSWORD.

# ── secrets (generate fresh; never commit the filled-in .env) ──
#   POSTGRES_PASSWORD : `openssl rand -hex 32`
#   REDIS_PASSWORD    : `openssl rand -hex 32`
#   LIVEKIT_API_SECRET: `openssl rand -hex 32`  (the LiveKit *secret*; the key
#                       *name* is fixed as "pulse-prod" in livekit.yaml + below)
#   MINIO_ROOT_PASSWORD: `openssl rand -hex 32`  (S3-API admin)
POSTGRES_PASSWORD=__CHANGE_ME__
REDIS_PASSWORD=__CHANGE_ME__
LIVEKIT_API_SECRET=__CHANGE_ME__
MINIO_ROOT_USER=pulse-admin
MINIO_ROOT_PASSWORD=__CHANGE_ME__

# ── encrypted backups (OPTIONAL — opt-in via COMPOSE_PROFILES) ──
# Pulse runs fine without backups. To enable the restic sidecar
# (Postgres + MinIO + avatars + guild_icons → local repo):
#
#   1. Uncomment the two lines below
#   2. Generate RESTIC_PASSWORD with `openssl rand -base64 32`
#   3. Save it to a password manager AND on paper, off-host. Lose this
#      and the repo is unrecoverable (restic scrypt+AES-256).
#   4. `docker compose up -d` will now bring up `pulse_backup`.
#
# See infra/prod/DEPLOY.md → Backups and infra/prod/backup/restore.md.
# COMPOSE_PROFILES=backup
# RESTIC_PASSWORD=__CHANGE_ME__

# ── Postgres (the pulse_postgres container; auth + chat-gateway connect here) ──
POSTGRES_USER=dcc
POSTGRES_DB=dcc
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis (the pulse_redis container; embed REDIS_PASSWORD here too) ──
REDIS_URL=redis://:__CHANGE_ME__@redis:6379/0

# ── JWT (RS256) — keypair lives at ./secrets/jwt_{private,public}.pem on the
#    server, mounted into the containers at /secrets ──
JWT_PRIVATE_KEY_FILE=/secrets/jwt_private.pem
JWT_PUBLIC_KEY_FILE=/secrets/jwt_public.pem
JWT_ISSUER=dcc-auth
JWT_AUDIENCE=dcc

# ── inter-service URLs (container names on pulse-net) ──
AUTH_JWKS_URL=http://auth:8000/.well-known/jwks.json
MEDIA_SVC_URL=http://media-svc:8000
# voice-signaling calls chat-gateway to verify channel membership before
# issuing a LiveKit token — DO NOT leave unset in production.
CHAT_GATEWAY_URL=http://chat-gateway:8000

# Shared secret for service-to-service calls. Used by:
#   * chat-gateway → voice-signaling (POST /internal/evict-from-voice — Ban/Kick)
#   * auth         → chat-gateway    (POST /internal/users/{id}/purge — DELETE /me)
# Must be IDENTICAL across all services. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️  CRITICAL: If left empty, voice-eviction on ban/kick is disabled! Banned
#     users already in LiveKit will remain connected. Banned/kicked users will
#     remain in voice channels and account deletion will fail. Generate a value now.
INTERNAL_SERVICE_SECRET=__CHANGE_ME__
# Auth → chat-gateway purge timeout (seconds). 30s default is generous;
# raise for huge accounts (thousands of messages → MinIO attachment sweep).
CHAT_GATEWAY_PURGE_TIMEOUT_S=30

# Auth-svc rate-limiter trusts X-Forwarded-For only when the immediate peer
# matches one of these IPs/CIDRs (CSV). In the production stack, auth sits
# behind pulse_web on pulse-net; set this to the pulse_web container's
# bridge IP (or the bridge subnet itself). The default is loopback-only
# which would lump *every* request into one bucket through pulse_web —
# fine for dev, bad for prod.
# To discover the bridge: `docker network inspect pulse-net` and pick the
# /24 from `IPAM.Config[0].Subnet`.
TRUSTED_PROXIES=127.0.0.1,::1,10.0.6.0/24

# ── CORS — the public origin only ──
CORS_ALLOW_ORIGINS=https://howispulse.com

# ── snowflake worker IDs (auth=1, chat=2, voice=3) ──
SNOWFLAKE_WORKER_ID_AUTH=1
SNOWFLAKE_WORKER_ID_CHAT=2
SNOWFLAKE_WORKER_ID_VOICE=3

# ── LiveKit (voice-signaling issues tokens with this pair; livekit.yaml gets
#    the secret via LIVEKIT_KEYS = "${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}") ──
LIVEKIT_API_KEY=pulse-prod
LIVEKIT_URL=wss://howispulse.com/livekit
# Internal address for server-side LiveKit API calls (reconcile loop + admin
# ops). Bypasses the public Caddy/nginx path so the startup reconcile keeps
# working *during* a deploy (when the web layer is down). Needs the
# host.docker.internal:host-gateway extra_hosts entry on voice-signaling.
# Unset → falls back to LIVEKIT_URL (fine in dev, already localhost).
LIVEKIT_API_URL=http://host.docker.internal:7880

# ── MediaMTX (media-svc builds push/playback URLs from these) ──
#   API is polled via the host (MediaMTX runs network_mode: host)
MEDIAMTX_API_URL=http://host.docker.internal:9997/v3/paths/list
#   ingest host = the public hostname the GSR sidecar pushes RTMPS/SRT to
MEDIAMTX_INGEST_HOST=howispulse.com
MEDIAMTX_RTMPS_PORT=1936
#   public base for WHEP playback URLs → https://howispulse.com/whep/channel-<id>/whep
MEDIAMTX_PUBLIC_BASE=https://howispulse.com/whep

# ── MinIO (S3-compatible object store for message attachments) ──
#   S3_INTERNAL_ENDPOINT : how chat-gateway reaches MinIO for bucket-management
#                          ops (delete object, bucket creation). Container DNS.
#   S3_PUBLIC_ENDPOINT   : the host the browser uses. MinIO refuses to honour a
#                          path prefix in its server URL, so this is host-only;
#                          nginx forwards `/pulse-attachments/*` straight to
#                          minio:9000. MUST match MINIO_SERVER_URL on the minio
#                          container — otherwise signatures don't verify.
#   S3_BUCKET            : pre-created by the minio-init compose service.
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://howispulse.com
S3_REGION=us-east-1
S3_BUCKET=pulse-attachments
# env_file does NOT interpolate ${...} — these are passed literally to the app.
# Keep in sync with MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above (signatures will
# silently fail with 403 otherwise — the strings must match byte-for-byte).
S3_ACCESS_KEY=pulse-admin
S3_SECRET_KEY=__CHANGE_ME__

# Web-Push (VAPID). Setting both keys here is the RECOMMENDED production path:
# it bypasses the on-disk ./data/vapid.json file entirely (no volume, no
# root-owned-volume chown footgun). Without them chat-gateway auto-generates on
# startup and persists to ./data/vapid.json — that needs a *writable* volume on
# that path, else every restart invalidates all push subscriptions.
#
# VAPID_PRIVATE_KEY accepts the PKCS#8 PEM either raw OR base64-encoded. Use the
# BASE64 form here: a multi-line PEM cannot survive a Docker env_file (no
# multi-line values, and Compose does not expand \n escapes). VAPID_PUBLIC_KEY
# is the raw P-256 point, base64url, single line — paste it as-is.
#
# Generate a keypair (prints exactly these two values):
#   uv run python -c "import base64;from cryptography.hazmat.primitives import serialization as s;from cryptography.hazmat.primitives.asymmetric import ec;k=ec.generate_private_key(ec.SECP256R1());pem=k.private_bytes(s.Encoding.PEM,s.PrivateFormat.PKCS8,s.NoEncryption());pub=k.public_key().public_bytes(s.Encoding.X962,s.PublicFormat.UncompressedPoint);print('VAPID_PRIVATE_KEY='+base64.b64encode(pem).decode());print('VAPID_PUBLIC_KEY='+base64.urlsafe_b64encode(pub).rstrip(b'=').decode())"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Account-Recovery / Email (auth-svc) ──
# APP_BASE_URL: Basis-URL für die Links in Reset-/Verify-Mails. MUSS in Prod auf
# die öffentliche Domain zeigen — ohne den Wert landen die Mail-Links auf
# http://localhost:5173 und der User kann sein Passwort nicht zurücksetzen.
APP_BASE_URL=https://howispulse.com
# SMTP: ungesetzt → auth-svc loggt Reset/Verify-Links als `email_skipped` (INFO,
# via `docker logs pulse_auth` einsehbar). Für echten Mailversand entweder hier
# alle Werte setzen ODER im Admin-Panel unter „Email" konfigurieren (DB-Config
# gewinnt vor diesen Env-Vars; Provider-Presets z.B. Brevo, 300 Mails/Tag free).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@howispulse.com
# SMTP_USE_SSL=false   # true ≈ Port 465 implicit TLS; false ≈ Port 587 STARTTLS

# ── WebAuthn / Passkeys (auth-svc) ──
# Die Relying-Party-ID MUSS ein registrierbares Domain-Suffix JEDER Origin sein,
# auf der die Ceremony läuft. In Prod = die blanke Apex-Domain (kein Schema, kein
# Port). WEBAUTHN_ORIGIN ist eine CSV erlaubter Origins (die Electron-App lädt
# dieselbe Remote-URL → kein Extra-Eintrag nötig). Falsche Werte → Passkey-
# Registrierung/Login schlägt mit „verification failed" fehl.
WEBAUTHN_RP_ID=howispulse.com
WEBAUTHN_ORIGIN=https://howispulse.com
# WEBAUTHN_RP_NAME=Pulse                  # Name in der Authenticator-Consent-UI
# WEBAUTHN_CHALLENGE_TTL_SECONDS=300      # Lebensdauer des Challenge-Tickets

# Token-cleanup intervals (auth-svc). Defaults sind production-tauglich, aber overrides für Debugging/kürzere Aufbewahrung:
# TOKEN_CLEANUP_INTERVAL_SECONDS=86400
# TOKEN_CLEANUP_GRACE_DAYS_EXPIRED=7
# TOKEN_CLEANUP_GRACE_DAYS_REVOKED=30

# Web-Push subscription cleanup (chat-gateway). Default: idle subs werden nach 60 Tagen gelöscht.
# PUSH_SUBSCRIPTION_IDLE_DAYS=60

# ── Identity / Cert-Modell (DE 11) — CLOUD instance ──────────────────────────
# This deployment IS the Pulse cloud. **PULSE_INSTANCE_MODE MUST be `cloud`** —
# the config default is `self-host`, so WITHOUT this line the chat-gateway boots
# in self-host mode and cert/CRL/Cloud-JWKS/profile handling all run in the
# wrong mode. (Self-host instances run the all-in-one image, which sets
# `self-host` in 07-render-env.sh.)
PULSE_INSTANCE_MODE=cloud
# Reserved value 0 = the Cloud instance.
PULSE_INSTANCE_ID=0
# Public OIDC issuer baked into Identity-Certs. MUST be identical on auth-svc
# (signs the cert) and chat-gateway (validates it). Keep = the public origin.
PULSE_OIDC_ISSUER=https://howispulse.com
# Origin the chat-gateway polls for the CRL + Cloud-JWKS. On the cloud = itself.
PULSE_CLOUD_ORIGIN=https://howispulse.com
# NOTE: SESSION_SIGNING_KEY_FILE + CHAT_GATEWAY_CHALLENGE_SECRET are only used by
# the self-host cert-LOGIN flow; the cloud does not need them.
